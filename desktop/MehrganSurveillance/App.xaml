<Application x:Class="MehrganSurveillance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ================================================================= -->
        <!-- سیستم طراحی مدرن سازمانی سامانه نظارت تصویری هوشمند مهرگان (VMS)  -->
        <!-- پالت رنگی تیره حرفه‌ای الهام‌گرفته از NetVideo Enterprise VMS      -->
        <!-- ================================================================= -->

        <!-- رنگ‌های پایه و پس‌زمینه‌های تیره صنعتی NetVideo -->
        <Color x:Key="BackgroundLightColor">#161B26</Color>       <!-- سرمه‌ای تیره پس‌زمینه اصلی (NetVideo Deep Slate) -->
        <Color x:Key="SurfaceCardColor">#202634</Color>           <!-- سرمه‌ای کارت‌ها و پنل‌ها (NetVideo Tile Surface) -->
        <Color x:Key="SurfaceSidebarColor">#1B202C</Color>        <!-- پس‌زمینه پنل‌های جانبی -->
        <Color x:Key="BorderLightColor">#2C3548</Color>           <!-- خطوط جداکننده ظریف تیره -->
        <Color x:Key="BorderStrongColor">#38445B</Color>          <!-- کادرهای تاکید شده -->

        <!-- رنگ‌های برند و ناوبری با طیف آبی درخشان NetVideo -->
        <Color x:Key="NavyDarkColor">#11151E</Color>              <!-- هدر و نوار ابزار فوقانی تیره -->
        <Color x:Key="NavyLightColor">#262E40</Color>             <!-- سرمه‌ای روشن‌تر برای هاور کاشی‌ها -->
        <Color x:Key="PrimaryColor">#1A73E8</Color>               <!-- آبی تخصصی NetVideo -->
        <Color x:Key="PrimaryHoverColor">#2563EB</Color>
        <Color x:Key="AccentPurpleColor">#38BDF8</Color>          <!-- آبی فیروزه‌ای روشن هایلایت -->
        <Color x:Key="AccentBlueColor">#0EA5E9</Color>            <!-- آبی کبالت ناوبری -->
        <Color x:Key="AccentCyanColor">#06B6D4</Color>
        <Color x:Key="DarkVideoWallColor">#080B11</Color>         <!-- وال ویدیویی تیره سینمایی -->

        <!-- رنگ‌های نشانگر وضعیت عملیاتی (Status Colors) -->
        <Color x:Key="SuccessColor">#10B981</Color>               <!-- سبز پخش زنده موفق -->
        <Color x:Key="SuccessBgColor">#064E3B</Color>
        <Color x:Key="WarningColor">#F59E0B</Color>               <!-- کهربایی بافرینگ و اتصال -->
        <Color x:Key="WarningBgColor">#451A03</Color>
        <Color x:Key="DangerColor">#EF4444</Color>                <!-- قرمز خطا و قطع اضطراری -->
        <Color x:Key="DangerBgColor">#450A0A</Color>
        <Color x:Key="MutedColor">#64748B</Color>                 <!-- خاکستری وضعیت غیرفعال -->

        <!-- رنگ‌های متون روی پس‌زمینه تیره -->
        <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>

        <!-- SolidColorBrush Resources -->
        <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceCardColor}" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SurfaceSidebarColor}" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

        <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}" />
        <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="DarkVideoWallBrush" Color="{StaticResource DarkVideoWallColor}" />

        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

        <!-- ================================================================= -->
        <!-- استایل‌های دکمه‌های سازمانی و مدرن (NetVideo Dark VMS Buttons)     -->
        <!-- ================================================================= -->

        <!-- ۱. دکمه اصلی (Primary Action) -->
        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۲. دکمه ثانویه (Secondary Action) -->
        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Background" Value="#252C3D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E374D" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۳. دکمه خطر / قطع (Danger Action) -->
        <Style TargetType="Button" x:Key="DangerButtonStyle">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۴. دکمه موفقیت / اتصال سبز (Success Action) -->
        <Style TargetType="Button" x:Key="SuccessButtonStyle">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#047857" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۵. دکمه آیکونی کوچک و فشرده (Compact Tool Icon Button) -->
        <Style TargetType="Button" x:Key="IconToolButtonStyle">
            <Setter Property="Background" Value="#1E2534" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#283246" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۶. استایل تب‌های فوقانی ناوبری NetVideo VMS (Top Header Tabs) -->
        <Style TargetType="Button" x:Key="NavTabButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Background" Value="#1C263B" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ۶-ب. استایل کارت‌های بزرگ صفحه اصلی (NetVideo Common Function Tile Button) -->
        <Style TargetType="Button" x:Key="NetVideoTileButtonStyle">
            <Setter Property="Background" Value="#202634" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2A3244" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#262E40" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#1E2536" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ۶-ج. استایل آیکون‌های ردیف پایین صفحه اصلی (NetVideo Basic Function Icon Button) -->
        <Style TargetType="Button" x:Key="NetVideoBasicFuncButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BasicBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BasicBorder" Property="Background" Value="#2A3347" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ۷. دکمه‌های کنترل نوار تایم‌لاین پایینی (Timeline Action Button) -->
        <Style TargetType="Button" x:Key="TimelineButtonStyle">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- استایل مدرن کادرهای متنی تیره (Modern Dark TextBox) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#131722" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- استایل CheckBox برای پس‌زمینه تیره -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <!-- استایل DataGrid برای تم تیره -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181D29" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="RowBackground" Value="#1C2230" />
            <Setter Property="AlternatingRowBackground" Value="#202737" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2A3244" />
            <Setter Property="VerticalGridLinesBrush" Value="#2A3244" />
            <Setter Property="BorderBrush" Value="#2C3548" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#131722" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#2C3548" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <!-- استایل مدرن اسکرول‌بار بسیار ظریف تیره (Slim Modern ScrollBar) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38445B" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
