<UserControl x:Class="MehrganSurveillance.Controls.CameraCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif">

    <!-- کادر اصلی سلول با استایل مانیتورینگ پیشرفته سازمانی و حاشیه‌های فشرده (Tight Spacing) -->
    <Border x:Name="RootBorder"
            Background="#060913"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Margin="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- سربرگ سلول: نوار فشرده و حرفه‌ای ۲۶ پیکسلی -->
                <RowDefinition Height="26" />
                <!-- ویوپورت رندر ویدیوی حقیقی بومی با پس‌زمینه سینمایی تیره -->
                <RowDefinition Height="*" />
                <!-- نوار زیرین متادیتای تکنیکال استریم (رزولوشن، کدک و آدرس محافظت‌شده) -->
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>

            <!-- ۱. سربرگ سلول -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,0,1"
                    Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- نشانگر اسلات و نام دوربین -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <!-- وضعیت زنده و کیفیت -->
                        <ColumnDefinition Width="Auto" />
                        <!-- ابزارهای کنترلی سریع -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- نشانگر اسلات -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border x:Name="SlotBadgeBorder"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="2"
                                Padding="4,1"
                                Margin="0,0,5,0">
                            <TextBlock x:Name="SlotBadgeText"
                                       Text="CH 01"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Consolas, Tahoma" />
                        </Border>

                        <TextBlock x:Name="CameraTitleText"
                                   Text="دوربین اسلات ۱"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center"
                                   MaxWidth="130"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- وضعیت اتصال زنده و پروفایل استریم -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- بج کیفیت استریم (Main یا Sub) -->
                        <Border x:Name="StreamProfileBadge"
                                Background="#FEF3C7"
                                CornerRadius="3"
                                Padding="5,1"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StreamProfileBadgeText"
                                       Text="Sub-Stream"
                                       FontSize="8.5"
                                       FontWeight="Bold"
                                       Foreground="#92400E" />
                        </Border>

                        <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="#64748B" Margin="0,0,4,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="آماده"
                                   FontSize="9.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- دکمه‌های کنترلی سلول -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- دکمه تخصیص/تنظیم دوربین -->
                        <Button x:Name="AssignButton"
                                ToolTip="تخصیص دوربین از رجیستری (⚙️)"
                                Style="{StaticResource IconToolButtonStyle}"
                                Width="22" Height="22"
                                Margin="0,0,3,0"
                                Click="AssignButton_Click">
                            <TextBlock Text="⚙" FontSize="10" />
                        </Button>

                        <!-- دکمه اتصال/قطع سریع -->
                        <Button x:Name="PlayPauseButton"
                                ToolTip="اتصال / قطع استریم این اسلات"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="22"
                                Padding="6,1"
                                Margin="0,0,3,0"
                                Click="PlayPauseButton_Click">
                            <TextBlock x:Name="PlayPauseButtonText" Text="▶" FontSize="9" FontWeight="Bold" />
                        </Button>

                        <!-- دکمه بزرگ‌نمایی تمام‌صفحه -->
                        <Button x:Name="MaximizeButton"
                                ToolTip="بزرگ‌نمایی این تصویر (دابل‌کلیک)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="22"
                                Width="22"
                                Padding="0"
                                Click="MaximizeButton_Click">
                            <TextBlock x:Name="MaximizeIconText" Text="⛶" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ۲. فضای رندر ویدیوی نیتیو LibVLC و لایه وضعیت آماده‌باش -->
            <Grid Grid.Row="1"
                  Background="#060913"
                  MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
                
                <!-- کنترل رندر ویدیوی حقیقی بومی LibVLC -->
                <vlc:VideoView x:Name="CellVideoView"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

                <!-- لایه ترسیم مستطیل چهره و بج رویداد (Face Detection Overlay) -->
                <Canvas x:Name="FaceOverlayCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Visible" />

                <!-- بج شناور تشخیص چهره -->
                <Border x:Name="FaceDetectedBadge"
                        Background="#DC2626"
                        CornerRadius="3"
                        Padding="5,2"
                        Margin="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 چهره شناسایی شد" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- لایه نگه‌دارنده شیک مانیتورینگ با خطوط هدایت Viewfinder در زمان عدم پخش -->
                <Border x:Name="PlaceholderOverlay"
                        Background="#090E1A"
                        Opacity="0.98"
                        Visibility="Visible"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <!-- خطوط کمکی و کراس‌هیر مهندسی مانیتورینگ -->
                        <Rectangle Width="28" Height="1" Fill="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-24,0,0" />
                        <Rectangle Width="1" Height="28" Fill="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-24,0,0" />

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="10">
                            <!-- آیکون دوربین دوربین مداربسته -->
                            <Border Width="38" Height="38"
                                    Background="#131C2E"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    CornerRadius="19"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6">
                                <TextBlock Text="📹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock x:Name="PlaceholderMessage"
                                       Text="تصویر زنده غیرفعال است"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#F1F5F9"
                                       HorizontalAlignment="Center" />

                            <TextBlock x:Name="PlaceholderSubText"
                                       Text="جهت مشاهده پخش زنده، دکمه اتصال را بفشارید"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,6"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                            <Button x:Name="QuickConnectOverlayButton"
                                    Content="اتصال استریم"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="9.5"
                                    Padding="10,3"
                                    HorizontalAlignment="Center"
                                    Click="PlayPauseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ۳. نوار زیرین مشخصات تکنیکال استریم (خارج از مستطیل HWND) -->
            <Border Grid.Row="2"
                    Background="#0B1120"
                    BorderBrush="#1E293B"
                    BorderThickness="0,1,0,0"
                    Padding="6,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- آدرس پوشش‌داده‌شده امن (بدون افشای رمز عبور) -->
                    <TextBlock x:Name="MaskedUrlText"
                               Grid.Column="0"
                               Text="rtsp://---"
                               FontSize="8"
                               Foreground="#64748B"
                               FontFamily="JetBrains Mono, Consolas, Courier New"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FlowDirection="LeftToRight" />

                    <!-- مشخصات فریم و کدک واقعی -->
                    <TextBlock x:Name="SpecsText"
                               Grid.Column="1"
                               Text="-- x --"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentPurpleBrush}"
                               FontFamily="JetBrains Mono, Consolas"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
