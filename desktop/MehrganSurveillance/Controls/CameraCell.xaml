<UserControl x:Class="MehrganSurveillance.Controls.CameraCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif">

    <Border x:Name="RootBorder"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1.5"
            CornerRadius="6"
            Margin="2"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- سربرگ سلول: نوار کنترل و وضعیت مستقل از پنجره HWND (جلوگیری قطعی از مشکل Airspace) -->
                <RowDefinition Height="34" />
                <!-- بخش رندر ویدیوی نیتیو LibVLC -->
                <RowDefinition Height="*" />
                <!-- نوار زیرین مشخصات استریم و کدک -->
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- ۱. سربرگ سلول -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- نشانگر اسلات و نام دوربین -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SlotBadgeBorder"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,6,0">
                            <TextBlock x:Name="SlotBadgeText"
                                       Text="کانال ۱"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>

                        <TextBlock x:Name="CameraTitleText"
                                   Text="دوربین اسلات ۱"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="160"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- وضعیت اتصال زنده -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#64748B" Margin="0,0,5,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="آماده اتصال"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- دکمه‌های کنترلی اختصاصی سلول -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- دکمه تغییر / انتخاب دوربین ثبت شده -->
                        <Button x:Name="AssignButton"
                                ToolTip="انتخاب یا تخصیص دوربین به این اسلات"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="5,2"
                                Height="24"
                                FontSize="10"
                                Margin="0,0,4,0"
                                Click="AssignButton_Click">
                            <TextBlock Text="⚙️" FontSize="10" />
                        </Button>

                        <!-- دکمه اتصال / قطع اختصاصی -->
                        <Button x:Name="PlayPauseButton"
                                ToolTip="اتصال / قطع استریم این دوربین"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="7,2"
                                Height="24"
                                FontSize="10"
                                Margin="0,0,4,0"
                                Click="PlayPauseButton_Click">
                            <TextBlock x:Name="PlayPauseButtonText" Text="▶ اتصال" FontSize="10" />
                        </Button>

                        <!-- دکمه تمام‌صفحه / بازگشت -->
                        <Button x:Name="MaximizeButton"
                                ToolTip="بزرگ‌نمایی این تصویر (دابل‌کلیک نیز کار می‌کند)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="6,2"
                                Height="24"
                                FontSize="10"
                                Click="MaximizeButton_Click">
                            <TextBlock x:Name="MaximizeIconText" Text="⛶" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ۲. فضای رندر ویدیوی نیتیو LibVLC و لایه پیام قطع/خطا -->
            <Grid Grid.Row="1"
                  Background="#090D16"
                  MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
                <!-- کنترل رندر ویدیوی حقیقی بومی LibVLC -->
                <vlc:VideoView x:Name="CellVideoView"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

                <!-- لایه نگهدارنده و پیام وضعیت (در حالت عدم پخش یا خطا نمایش می‌یابد) -->
                <Border x:Name="PlaceholderOverlay"
                        Background="#0F172A"
                        Opacity="0.95"
                        Visibility="Visible"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="12">
                        <TextBlock x:Name="PlaceholderIcon"
                                   Text="📹"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="PlaceholderMessage"
                                   Text="تصویر زنده غیرفعال است"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="PlaceholderSubText"
                                   Text="جهت مشاهده پخش زنده، دکمه اتصال را بفشارید"
                                   FontSize="9.5"
                                   Foreground="#94A3B8"
                                   Margin="0,4,0,8"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Button x:Name="QuickConnectOverlayButton"
                                Content="اتصال به این کانال"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="10"
                                Padding="10,4"
                                HorizontalAlignment="Center"
                                Click="PlayPauseButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ۳. نوار زیرین مشخصات فنی استریم -->
            <Border Grid.Row="2"
                    Background="#F1F5F9"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="6,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- نشانگر کیفیت استریم: Main یا Sub -->
                    <Border x:Name="StreamProfileBadge"
                            Grid.Column="0"
                            Background="#E2E8F0"
                            CornerRadius="3"
                            Padding="5,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StreamProfileBadgeText"
                                   Text="Sub-Stream (/1/2)"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <!-- آدرس پوشش داده شده (بدون افشای رمز) -->
                    <TextBlock x:Name="MaskedUrlText"
                               Grid.Column="1"
                               Text="rtsp://---"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="JetBrains Mono, Consolas, Courier New"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="6,0"
                               FlowDirection="LeftToRight" />

                    <!-- مشخصات فریم و کدک حقیقی -->
                    <TextBlock x:Name="SpecsText"
                               Grid.Column="2"
                               Text="-- x --"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
