<Window x:Class="MehrganSurveillance.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="سامانه نظارت تصویری مهرگان - کشف هوشمند و مدیریت دوربین‌ها (Smart Camera Discovery)"
        Height="820" Width="1340"
        MinWidth="1100" MinHeight="700"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- ۱. سربرگ پنجره و راهنما -->
            <RowDefinition Height="Auto" />
            <!-- ۲. نوار ابزار دستورات کشف شبکه -->
            <RowDefinition Height="Auto" />
            <!-- ۳. محتوای اصلی (لیست دوربین‌های کشف‌شده + پنل اعتبارسنجی و تست پخش) -->
            <RowDefinition Height="*" />
            <!-- ۴. نوار لاگ و گزارش‌های امن فرآیند کشف -->
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- ۱. سربرگ پنجره -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="کشف هوشمند دوربین‌های تحت شبکه (ONVIF WS-Discovery &amp; Subnet Scan)"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="شناسایی خودکار تجهیزات تیاندی، هایک‌ویژن، داهوا و استانداردهای ONVIF در شبکه محلی، اعتبارسنجی مستقل و تست زنده استریم"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- دکمه بستن/بازگشت -->
                <Button Grid.Column="1"
                        Content="بستن و بازگشت به سامانه"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="170"
                        Height="34"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- ۲. نوار ابزار دستورات کشف شبکه -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- دکمه کشف خودکار ONVIF -->
                <Button x:Name="StartOnvifDiscoveryButton"
                        Grid.Column="0"
                        Content="🔍 کشف خودکار ONVIF (WS-Discovery)"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,10,0"
                        Click="StartOnvifDiscoveryButton_Click" />

                <!-- بخش اسکن زیرشبکه -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="زیرشبکه:" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBox x:Name="SubnetPrefixInput"
                             Text="192.168.1"
                             Width="95"
                             Height="34"
                             FontSize="12"
                             FontFamily="JetBrains Mono, Consolas"
                             Padding="6,6"
                             VerticalContentAlignment="Center"
                             FlowDirection="LeftToRight"
                             Margin="0,0,6,0" />
                    <Button x:Name="StartSubnetScanButton"
                            Content="📡 اسکن کمکی زیرشبکه (IP Scan)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Padding="12,0"
                            Click="StartSubnetScanButton_Click" />
                </StackPanel>

                <!-- دکمه افزودن دستی -->
                <Button x:Name="ManualAddButton"
                        Grid.Column="2"
                        Content="➕ افزودن دستی (Manual Add)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="36"
                        Padding="12,0"
                        Margin="0,0,10,0"
                        Click="ManualAddButton_Click" />

                <!-- نوار پیشرفت و وضعیت -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                    <ProgressBar x:Name="DiscoveryProgressBar"
                                 Height="8"
                                 IsIndeterminate="False"
                                 Value="0"
                                 Maximum="100"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="DiscoveryStatusText"
                               Text="آماده آغاز عملیات کشف دوربین‌ها در شبکه محلی"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- آمار دستگاه‌های کشف‌شده -->
                <Border Grid.Column="4"
                        Background="#F1F5F9"
                        CornerRadius="6"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تعداد کشف‌شده: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="DiscoveredCountText" Text="۰" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ۳. محتوای اصلی: تفکیک دو ستونه (لیست دستگاه‌ها + پنل اعتبارسنجی، پروفایل و تست پخش) -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- ستون راست: لیست دوربین‌های شناسایی‌شده (Master) -->
                <ColumnDefinition Width="460" MinWidth="380" />
                <!-- ستون چپ: پنل جزئیات، احراز هویت، پروفایل و تست تصویر (Detail) -->
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- لیست دوربین‌های شناسایی‌شده -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="فهرست تجهیزات شناسایی‌شده در شبکه:"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8" />

                    <!-- لیست سفارشی دوربین‌ها -->
                    <ListBox x:Name="CamerasListBox"
                             Grid.Row="1"
                             BorderBrush="{StaticResource BorderLightBrush}"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             SelectionMode="Single"
                             SelectionChanged="CamerasListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- عنوان برند و آدرس IP -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Brand}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text=" - " FontSize="12" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding IpAddress}" FontFamily="JetBrains Mono, Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" FlowDirection="LeftToRight" />
                                        </StackPanel>

                                        <!-- برچسب وضعیت دستگاه -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="8,2">
                                            <TextBlock Text="{Binding StatePersianText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding StatusColorHex}" />
                                        </Border>

                                        <!-- مدل و نوع کشف -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="مدل: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Model}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text=" | متد: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding DiscoverySource}" FontSize="10" FontFamily="Consolas" Foreground="#0284C7" />
                                        </StackPanel>

                                        <!-- پیام وضعیت -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding StateMessage}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- پنل جزئیات، احراز هویت، انتخاب استریم و تست زنده -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CameraDetailPanel" Visibility="Visible">
                        <!-- هدر دوربین انتخابی -->
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SelectedCameraTitleText" Text="لطفاً یک دوربین را از لیست راست انتخاب نمایید" FontSize="14" FontWeight="Bold" Foreground="#0369A1" />
                                    <TextBlock x:Name="SelectedCameraSubText" Text="مشخصات اتصال، اطلاعات ONVIF و امکان تست زنده تصویر در این بخش نمایش می‌یابد." FontSize="11" Foreground="#0284C7" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="SelectedCameraIpBadge" Grid.Column="1" Text="--" FontFamily="JetBrains Mono, Consolas" FontSize="12" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            </Grid>
                        </Border>

                        <!-- بخش ۱: فرم ورود نام کاربری و رمز عبور -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="۱. اطلاعات کاربری و اعتبارسنجی دستگاه (Credentials):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- نام کاربری -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="نام کاربری (Username):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="UsernameInput" Text="admin" Height="32" Padding="6,4" FlowDirection="LeftToRight" />
                                    </StackPanel>

                                    <!-- کلمه عبور -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="کلمه عبور (Password):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <PasswordBox x:Name="PasswordInput" Height="32" Padding="6,4" FlowDirection="LeftToRight" />
                                    </StackPanel>

                                    <!-- دکمه احراز هویت و دریافت پروفایل‌ها -->
                                    <Button x:Name="AuthenticateButton"
                                            Grid.Column="2"
                                            Content="🔑 تست هویت و دریافت استریم‌ها"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="32"
                                            VerticalAlignment="Bottom"
                                            Padding="12,0"
                                            Click="AuthenticateButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- بخش ۲: اطلاعات فنی دستگاه و پروفایل‌های استریم کشف‌شده -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="۲. اطلاعات شناسایی دستگاه و پروفایل‌های ویدیویی (ONVIF Profiles):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="مدل دستگاه:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="DeviceModelText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="نسخه سفت‌افزار (Firmware):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="DeviceFirmwareText" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="شماره سریال:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="DeviceSerialText" Text="--" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- انتخاب پروفایل استریم اصلی یا فرعی -->
                                <TextBlock Text="انتخاب پروفایل جهت اتصال:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
                                <ComboBox x:Name="ProfilesComboBox"
                                          Height="32"
                                          SelectionChanged="ProfilesComboBox_SelectionChanged" />

                                <!-- نمایش امن آدرس RTSP استریم انتخابی با ماسک پسورد -->
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="آدرس استریم تولیدشده (محافظت‌شده با ماسک کلمه عبور):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBox x:Name="MaskedRtspUrlBox"
                                             IsReadOnly="True"
                                             Background="#F8FAFC"
                                             FontFamily="JetBrains Mono, Consolas"
                                             FontSize="11"
                                             Padding="6,4"
                                             FlowDirection="LeftToRight" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- بخش ۳: تست پخش زنده ویدیوی واقعی قبل از ثبت (Live Preview Test) -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="۳. تست پخش زنده تصویر با موتور بومی LibVLC (RTSP over TCP):" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                    <!-- دکمه تست زنده -->
                                    <Button x:Name="PreviewPlayButton"
                                            Grid.Column="1"
                                            Content="▶ تست زنده تصویر"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="30"
                                            Padding="10,0"
                                            Margin="0,0,6,0"
                                            Click="PreviewPlayButton_Click" />

                                    <!-- دکمه قطع تست -->
                                    <Button x:Name="PreviewStopButton"
                                            Grid.Column="2"
                                            Content="⏹ قطع تست"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Height="30"
                                            Padding="10,0"
                                            IsEnabled="False"
                                            Click="PreviewStopButton_Click" />
                                </Grid>

                                <!-- ویوپورت کوچک تست پخش زنده -->
                                <Border Height="220"
                                        Background="#000000"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid>
                                        <vlc:VideoView x:Name="PreviewVideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                        <!-- لایه پیام در زمان عدم اتصال -->
                                        <Border x:Name="PreviewPlaceholder" Background="#0F172A" Visibility="Visible">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="پیش‌نمایش تصویر غیرفعال است" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                                <TextBlock Text="پس از احراز هویت، روی «تست زنده تصویر» کلیک فرمایید تا فریم واقعی با LibVLC آزمایش شود." FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- بخش ۴: افزودن دوربین تاییدشده به رجیستری پایدار مهرگان -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="۴. ثبت رسمی دوربین در رجیستری پایدار سامانه مهرگان" FontWeight="Bold" FontSize="12" Foreground="#166534" />
                                    <TextBlock Text="اطلاعات کاربری با مکانیزم امن Windows DPAPI رمزنگاری شده و برای استفاده در نمایش تک‌دوربینه و چنددوربینه آماده می‌گردد." FontSize="10" Foreground="#15803D" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button x:Name="RegisterCameraButton"
                                        Grid.Column="1"
                                        Content="✔ افزودن به سامانه (ثبت دوربین)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Background="#16A34A"
                                        Height="36"
                                        Padding="16,0"
                                        Click="RegisterCameraButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ۴. نوار گزارش وقایع تشخیصی و لاگ امن فرآیند کشف -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="لاگ تشخیصی و رویدادهای کشف شبکه (فاقد اطلاعات حساس و کلمه عبور):"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Grid.Column="1"
                            Content="پاک‌سازی گزارش"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="10"
                            Padding="6,2"
                            Click="ClearLogButton_Click" />
                </Grid>

                <ListBox x:Name="DiscoveryLogListBox"
                         Grid.Row="1"
                         BorderBrush="{StaticResource BorderLightBrush}"
                         BorderThickness="1"
                         Background="#F8FAFC"
                         FontFamily="JetBrains Mono, Consolas"
                         FontSize="10"
                         FlowDirection="LeftToRight" />
            </Grid>
        </Border>
    </Grid>
</Window>
