<Window x:Class="MehrganSurveillance.ImageOptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="بهینه‌سازی هوشمند تصویر و ارتقای دقت پلاک‌خوان | AI Image Optimization Engine"
        Height="890" Width="1380"
        MinWidth="1150" MinHeight="720"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="#161B26"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- رنگ‌های پالت NetVideo Enterprise -->
        <SolidColorBrush x:Key="NetVideoDarkBg" Color="#161B26" />
        <SolidColorBrush x:Key="NetVideoHeaderBg" Color="#11151E" />
        <SolidColorBrush x:Key="NetVideoCardBg" Color="#202634" />
        <SolidColorBrush x:Key="NetVideoCardBorder" Color="#2D3748" />
        <SolidColorBrush x:Key="NetVideoPrimary" Color="#1A73E8" />
        <SolidColorBrush x:Key="NetVideoAccent" Color="#38BDF8" />
        <SolidColorBrush x:Key="NetVideoSuccess" Color="#10B981" />
        <SolidColorBrush x:Key="NetVideoWarning" Color="#F59E0B" />
        <SolidColorBrush x:Key="NetVideoDanger" Color="#EF4444" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#202634" />
            <Setter Property="BorderBrush" Value="#2D3748" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="NetVideoActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A73E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NetVideoSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A3446" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="#3B4861" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#37455C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NetVideoSuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- ۱. هدر شل VMS -->
            <RowDefinition Height="54" />
            <!-- ۲. فضای کاری دو ستونه -->
            <RowDefinition Height="*" />
            <!-- ۳. نوار وضعیت پایینی -->
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ۱. هدر بالای پنجره -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#0284C7" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="✨" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="موتور هوشمند پردازش و بهینه‌سازی تصویر (AI Image Optimization Engine)"
                                   FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="ارتقای دقت بازشناسی پلاک خودروهای متحرک (CLAHE, Denoise, Sharpen, Anti-Glare) بدون تغییر تنظیمات فیزیکی دوربین"
                                   FontSize="10.5" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- دکمه بستن پنجره -->
                <Button Grid.Column="2" Content="✕ بستن"
                        Style="{StaticResource NetVideoSecondaryButton}"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ۲. فضای کاری اصلی دو ستونه -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- ستون راست: انتخاب دوربین، پریست و اسلایدرهای تنظیمات (380px) -->
                <ColumnDefinition Width="380" />
                <!-- ستون چپ: مقایسه تصویری Before/After و جدول رقابت کاندیداها (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- ستون راست: پنل پیکربندی -->
            <!-- ========================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- کارت ۱: انتخاب دوربین -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="۱. انتخاب دوربین و پروفایل اختصاصی" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8" />

                            <TextBlock Text="دوربین مورد نظر جهت کالیبراسیون تصویر:" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <ComboBox x:Name="CameraSelectorComboBox"
                                      Height="32"
                                      Background="#161B26"
                                      Foreground="White"
                                      Margin="0,0,0,10"
                                      SelectionChanged="CameraSelectorComboBox_SelectionChanged" />

                            <TextBlock Text="انتخاب سناریو و پریست بهینه‌سازی:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />
                            <StackPanel Margin="4,0,0,0">
                                <RadioButton x:Name="PresetNightRadio" Content="🌙 شبانه (مهار نور شدید چراغ + CLAHE عمیق)" GroupName="Presets" IsChecked="True" Foreground="White" FontSize="11" Margin="0,0,0,6" Checked="PresetRadio_Checked" />
                                <RadioButton x:Name="PresetDaylightRadio" Content="☀️ روشنایی روز (کنتراست طبیعی + شارپنس لبه)" GroupName="Presets" Foreground="White" FontSize="11" Margin="0,0,0,6" Checked="PresetRadio_Checked" />
                                <RadioButton x:Name="PresetFastMovingRadio" Content="🏎 خودروهای پرسرعت (De-blur خطی + وضوح بالا)" GroupName="Presets" Foreground="White" FontSize="11" Margin="0,0,0,6" Checked="PresetRadio_Checked" />
                                <RadioButton x:Name="PresetLowLightRadio" Content="🔦 محیط‌های کم‌نور (تقویت گاما و حذف نویز)" GroupName="Presets" Foreground="White" FontSize="11" Margin="0,0,0,6" Checked="PresetRadio_Checked" />
                                <RadioButton x:Name="PresetGeneralRadio" Content="🏢 عمومی پیش‌فرض (General ANPR)" GroupName="Presets" Foreground="White" FontSize="11" Margin="0,0,0,6" Checked="PresetRadio_Checked" />
                                <RadioButton x:Name="PresetCustomRadio" Content="⚙ تنظیمات سفارشی کاربر (Custom Parameters)" GroupName="Presets" Foreground="White" FontSize="11" Margin="0,0,0,4" Checked="PresetRadio_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- کارت ۲: اسلایدرهای تنظیم دقیق پارامترهای پردازش -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="۲. پارامترهای تنظیم دقیق پردازش تصویر" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10" />

                            <!-- اسلایدر حذف نویز -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="کاهش نویز سنسور (Denoise):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="DenoiseValueText" Grid.Column="1" Text="25" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="100" Value="25" SmallChange="5" LargeChange="10" Margin="0,0,0,10" ValueChanged="Slider_ValueChanged" />

                            <!-- اسلایدر افزایش وضوح -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="افزایش وضوح و شارپنس (Sharpen):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="SharpenValueText" Grid.Column="1" Text="55" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="SharpenSlider" Minimum="0" Maximum="100" Value="55" SmallChange="5" LargeChange="10" Margin="0,0,0,10" ValueChanged="Slider_ValueChanged" />

                            <!-- اسلایدر CLAHE -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تعدیل کنتراست موضعی (CLAHE Clip):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="ClaheValueText" Grid.Column="1" Text="3.2" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="ClaheSlider" Minimum="1.0" Maximum="5.0" Value="3.2" SmallChange="0.2" LargeChange="0.5" Margin="0,0,0,10" ValueChanged="Slider_ValueChanged" />

                            <!-- اسلایدر اصلاح گاما -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اصلاح روشنایی غیرخطی (Gamma):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="GammaValueText" Grid.Column="1" Text="0.80" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="GammaSlider" Minimum="0.2" Maximum="2.5" Value="0.80" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="Slider_ValueChanged" />

                            <!-- اسلایدر کنتراست خطی -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ضریب کنتراست خطی (Contrast):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="ContrastValueText" Grid.Column="1" Text="1.45" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="ContrastSlider" Minimum="0.5" Maximum="2.5" Value="1.45" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="Slider_ValueChanged" />

                            <!-- چک‌باکس‌های تکنیک‌های پیشرفته -->
                            <CheckBox x:Name="PerspectiveDeskewCheckBox" Content="اصلاح زاویه و شیب پلاک (Perspective Deskew)" Foreground="#E2E8F0" FontSize="11" IsChecked="True" Margin="0,4,0,8" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
                            <CheckBox x:Name="AdaptiveThresholdCheckBox" Content="باینریزاسیون تطبیقی (Adaptive Thresholding)" Foreground="#E2E8F0" FontSize="11" IsChecked="True" Margin="0,0,0,4" Checked="FilterOption_Changed" Unchecked="FilterOption_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- کارت ۳: دکمه‌های عملیاتی -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Button x:Name="ProcessEvaluateButton"
                                    Content="⚡ پردازش و ارزیابی فیلترها روی پلاک"
                                    Style="{StaticResource NetVideoActionButton}"
                                    Margin="0,0,0,8"
                                    Click="ProcessEvaluateButton_Click" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="SaveProfileButton"
                                        Content="💾 ذخیره پروفایل دوربین"
                                        Style="{StaticResource NetVideoSuccessButton}"
                                        Margin="0,0,4,0"
                                        Click="SaveProfileButton_Click" />
                                <Button Grid.Column="1" x:Name="ResetProfileButton"
                                        Content="🔄 پیش‌فرض کارخانه"
                                        Style="{StaticResource NetVideoSecondaryButton}"
                                        Margin="4,0,0,0"
                                        Click="ResetProfileButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================= -->
            <!-- ستون چپ: مقایسه و نتایج -->
            <!-- ========================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- بخش الف: کارت مقایسه بصری Side-by-Side (330px) -->
                    <RowDefinition Height="340" />
                    <!-- بخش ب: جدول رقابت و ممیزی کاندیداها (*) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- الف: کارت‌های مقایسه Side-by-Side قبل و بعد -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <!-- پلاک اولیه (Before) -->
                        <ColumnDefinition Width="*" />
                        <!-- پلاک بهینه‌شده (After) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ۱. کارت قبل از پردازش (Before / Raw Crop) -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#475569" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="تصویر خام اولیه (Before)" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="برش خام دریافتی از دوربین بدون فیلتر" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- تصویر پلاک اولیه -->
                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                <Image x:Name="BeforePlateImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- نتیجه OCR اولیه -->
                            <Border Grid.Row="2" Background="#161B26" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="متن خوانده‌شده اولیه:" FontSize="9.5" Foreground="#94A3B8" />
                                        <TextBlock x:Name="BeforeOcrText" Text="۱۲ ب ۳۴۵ ایران ۶۷" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" />
                                    </StackPanel>
                                    <TextBlock x:Name="BeforeConfidenceText" Grid.Column="1" Text="اطمینان: ۶۸٪" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" FontWeight="Bold" />
                                </Grid>
                            </Border>

                            <!-- معیارهای کیفیت اولیه -->
                            <WrapPanel Grid.Row="3">
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="BeforeSharpnessText" Text="شارپنس: ۸۵" FontSize="9.5" Foreground="#94A3B8" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="BeforeContrastText" Text="کنتراست: ۳۲" FontSize="9.5" Foreground="#94A3B8" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="BeforeGlareText" Text="سوختگی نور: ۱۸٪" FontSize="9.5" Foreground="#EF4444" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- ۲. کارت بعد از پردازش هوشمند (After / Enhanced Crop) -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Margin="6,0,0,0" BorderBrush="#0284C7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="بهینه‌شده با هوش مصنوعی (After)" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="WinningMethodBadgeText" Text="Glare Suppression + CLAHE" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="ImprovementBadgeText" Text="بهبود دقت: +۲۶٪" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                            </Grid>

                            <!-- تصویر پلاک بهینه‌شده -->
                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="6" Margin="0,0,0,8">
                                <Image x:Name="AfterPlateImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- نتیجه OCR بهینه‌شده -->
                            <Border Grid.Row="2" Background="#161B26" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="متن بازشناسی‌شده نهایی (بهترین نسخه):" FontSize="9.5" Foreground="#34D399" />
                                        <TextBlock x:Name="AfterOcrText" Text="۱۲ ب ۳۴۵ ایران ۶۷" FontSize="13" FontWeight="Bold" Foreground="#10B981" />
                                    </StackPanel>
                                    <TextBlock x:Name="AfterConfidenceText" Grid.Column="1" Text="اطمینان: ۹۴٪" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" FontWeight="Bold" />
                                </Grid>
                            </Border>

                            <!-- معیارهای کیفیت نهایی -->
                            <WrapPanel Grid.Row="3">
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="AfterSharpnessText" Text="شارپنس: ۱۴۵ (ارتقا)" FontSize="9.5" Foreground="#38BDF8" FontWeight="Bold" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="AfterContrastText" Text="کنتراست: ۵۴ (ارتقا)" FontSize="9.5" Foreground="#38BDF8" FontWeight="Bold" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="2">
                                    <TextBlock x:Name="AfterGlareText" Text="مهار نور: ۱۰۰٪ موفق" FontSize="9.5" Foreground="#10B981" FontWeight="Bold" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ب: جدول ارزیابی و رقابت نامزدهای پردازش (Candidate Variations Table) -->
                <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📊 جدول رقابت و اعتبارسنجی نسخه‌های پردازش‌شده (Candidate Competition Matrix)"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcessingDurationText" Grid.Column="1" Text="مدت زمان پردازش: ۱۸.۵ میلی‌ثانیه" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid x:Name="CandidatesDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#161B26"
                                  BorderBrush="#252D3D"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#252D3D"
                                  RowBackground="#1A2232"
                                  AlternatingRowBackground="#161B26"
                                  Foreground="White"
                                  FontSize="11"
                                  SelectionMode="Single"
                                  SelectionChanged="CandidatesDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="روش پردازش / فیلتر" Binding="{Binding FilterName}" Width="160" />
                                <DataGridTextColumn Header="متن استخراجی OCR" Binding="{Binding OcrRawText}" Width="130" />
                                <DataGridTextColumn Header="ضریب اطمینان" Binding="{Binding OcrConfidence, StringFormat='{}{0:P0}'}" Width="90" />
                                <DataGridTextColumn Header="شارپنس لبه" Binding="{Binding Metrics.LaplacianSharpness, StringFormat='{}{0:F0}'}" Width="85" />
                                <DataGridTextColumn Header="کنتراست" Binding="{Binding Metrics.ContrastStdDev, StringFormat='{}{0:F1}'}" Width="75" />
                                <DataGridTextColumn Header="سوختگی نور" Binding="{Binding Metrics.OverexposedPercentage, StringFormat='{}{0:F1}%'}" Width="85" />
                                <DataGridTextColumn Header="امتیاز شایستگی" Binding="{Binding CompositeScore, StringFormat='{}{0:F1}'}" Width="100" />
                                <DataGridTextColumn Header="وضعیت انتخاب" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- ۳. نوار وضعیت پایینی -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarMessageTextBlock"
                           Grid.Column="0"
                           Text="موتور بهینه‌سازی هوشمند تصویر آماده به کار است. تمامی محاسبات بر روی بافر مستقل انجام شده و فریم اصلی محافظت می‌گردد."
                           FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineStateTextBlock"
                           Grid.Column="1"
                           Text="وضعیت: آماده پردازش محلی (CPU/DirectML)"
                           FontSize="10.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
