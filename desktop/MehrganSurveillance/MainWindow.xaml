<Window x:Class="MehrganSurveillance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MehrganSurveillance.Controls"
        mc:Ignorable="d"
        Title="سامانه نظارت تصویری هوشمند مهرگان | Mehrgan VMS Enterprise (نسخه ویندوز)"
        Height="920" Width="1440"
        MinWidth="1150" MinHeight="750"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ۱. نوار ابزار اصلی شل برنامه (Application Top Shell Bar - 48px) -->
            <RowDefinition Height="48" />
            <!-- ۲. فضای کاری اصلی نظارت (Live Video Wall + Collapsible Sidebar) -->
            <RowDefinition Height="*" />
            <!-- ۳. نوار مانیتورینگ وضعیت و پنل کشویی لاگ‌ها (Collapsible Status & Diagnostics) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ۱. نوار ابزار اصلی شل برنامه (Enterprise VMS Top Shell)           -->
        <!-- ================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource NavyDarkBrush}"
                Padding="14,0"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- لوگو و برند مهرگان -->
                    <ColumnDefinition Width="Auto" />
                    <!-- چیدمان‌های ماتریسی ۱x۱, ۲x۲, ۳x۳ و کنترل همگانی -->
                    <ColumnDefinition Width="*" />
                    <!-- ساعت زنده، وضعیت پروتکل و کشف هوشمند -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- برندینگ سامانه مهرگان -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="30" Height="30"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="6"
                            Margin="0,0,10,0">
                        <TextBlock Text="🛡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سامانه نظارت تصویری مهرگان"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text="Mehrgan VMS Enterprise | RTSP TCP Engine"
                                   FontSize="9"
                                   FontFamily="JetBrains Mono, Consolas, Segoe UI"
                                   Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- کنترل‌های مرکزی: انتخاب چیدمان ماتریسی و عملیات گروهی -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- سوئیچرهای چیدمان (Segmented Layout Controls) -->
                    <Border Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="3"
                            Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Layout1x1Button"
                                    Content="⊞ ۱×۱"
                                    ToolTip="چیدمان تک‌تصویر با حداکثر کیفیت (/1/1)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="Transparent"
                                    Foreground="#F1F5F9"
                                    BorderThickness="0"
                                    Padding="10,4"
                                    Height="28"
                                    Margin="0,0,2,0"
                                    Click="Layout1x1Button_Click" />

                            <Button x:Name="Layout2x2Button"
                                    Content="⊞ ۲×۲"
                                    ToolTip="چیدمان ۴ تصویر با استریم فرعی (/1/2)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,4"
                                    Height="28"
                                    Margin="0,0,2,0"
                                    Click="Layout2x2Button_Click" />

                            <Button x:Name="Layout3x3Button"
                                    Content="⊞ ۳×۳"
                                    ToolTip="چیدمان ۹ تصویر با استریم فرعی (/1/2)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="Transparent"
                                    Foreground="#F1F5F9"
                                    BorderThickness="0"
                                    Padding="10,4"
                                    Height="28"
                                    Click="Layout3x3Button_Click" />
                        </StackPanel>
                    </Border>

                    <!-- دکمه‌های کنترل همگانی استریم‌ها -->
                    <Button x:Name="ConnectAllButton"
                            Content="▶ اتصال همه"
                            ToolTip="برقراری اتصال تمام استریم‌های فعال در چیدمان جاری"
                            Style="{StaticResource SuccessButtonStyle}"
                            Height="30"
                            Padding="12,0"
                            Margin="0,0,6,0"
                            Click="ConnectAllButton_Click" />

                    <Button x:Name="DisconnectAllButton"
                            Content="⏹ قطع همه"
                            ToolTip="قطع فوری کلیه استریم‌ها جهت کاهش مصرف شبکه و پردازنده"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,14,0"
                            Click="DisconnectAllButton_Click" />
                </StackPanel>

                <!-- ابزارهای سمت چپ: کشف هوشمند، وضعیت و ساعت -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- دکمه ماژول کشف هوشمند -->
                    <Button Content="🔍 کشف هوشمند (ONVIF)"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="#0369A1"
                            Height="30"
                            Padding="12,0"
                            Margin="0,0,12,0"
                            Click="OpenDiscoveryWindow_Click" />

                    <!-- نشانگر وضعیت موتور و شبکه -->
                    <Border Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="10,4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineStatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,5,0" />
                            <TextBlock x:Name="EngineStatusText"
                                       Text="موتور آماده (TCP)"
                                       FontSize="10"
                                       Foreground="#E2E8F0"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <!-- ساعت زنده مانیتورینگ -->
                    <TextBlock x:Name="LiveClockText"
                               Text="--:--:--"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="JetBrains Mono, Consolas"
                               Foreground="#38BDF8"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ۲. فضای کاری اصلی نظارت (Live Video Wall + Collapsible Sidebar)  -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="10,10,10,6">
            <Grid.ColumnDefinitions>
                <!-- ویدیو وال مرکزی مانیتورینگ (بزرگ‌ترین بخش صفحه) -->
                <ColumnDefinition Width="*" />
                <!-- پنل کناری تاشو جهت مدیریت دوربین‌ها و اسلات‌ها -->
                <ColumnDefinition x:Name="SidebarColumn" Width="290" MinWidth="220" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- بخش ویدیو وال مانیتورینگ -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <!-- بنر اطلاع‌رسانی حالت تمام‌صفحه (در زمان بزرگ‌نمایی) -->
                    <RowDefinition Height="Auto" />
                    <!-- شبکه ماتریسی دوربین‌ها -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- بنر حالت تمام‌صفحه (Maximized State Floating Banner) -->
                <Border x:Name="MaximizedBanner"
                        Grid.Row="0"
                        Background="#0F172A"
                        BorderBrush="#0284C7"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaximizedBannerText"
                                       Text="حالت تمام‌صفحه با استریم باکیفیت اصلی (Main-Stream /1/1) فعال است."
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="— برای بازگشت کلید Esc یا دابل‌کلیک کنید."
                                       FontSize="10.5"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="بازگشت به چیدمان قبلی ❐"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="26"
                                Padding="12,0"
                                Click="RestoreMaximized_Click" />
                    </Grid>
                </Border>

                <!-- کادر تیره سینمایی برای وال دوربین‌ها -->
                <Border Grid.Row="1"
                        Background="#050811"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <UniformGrid x:Name="CameraGrid"
                                 Rows="2"
                                 Columns="2"
                                 Margin="2">
                        <controls:CameraCell x:Name="CameraCell0" />
                        <controls:CameraCell x:Name="CameraCell1" />
                        <controls:CameraCell x:Name="CameraCell2" />
                        <controls:CameraCell x:Name="CameraCell3" />
                        <controls:CameraCell x:Name="CameraCell4" />
                        <controls:CameraCell x:Name="CameraCell5" />
                        <controls:CameraCell x:Name="CameraCell6" />
                        <controls:CameraCell x:Name="CameraCell7" />
                        <controls:CameraCell x:Name="CameraCell8" />
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- پنل کناری تاشو: رجیستری دوربین‌ها و بازرس اسلات انتخابی       -->
            <!-- ============================================================= -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- سربرگ سایدبار با دکمه جمع‌کردن -->
                        <RowDefinition Height="Auto" />
                        <!-- لیست جستجو و دوربین‌های رجیستری -->
                        <RowDefinition Height="*" />
                        <!-- بازرس و تنظیم اسلات انتخاب شده -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- سربرگ سایدبار -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="دوربین‌های ثبت‌شده"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="RegistryCountBadge"
                                    Background="#E0F2FE"
                                    CornerRadius="10"
                                    Padding="6,1"
                                    Margin="6,0,0,0">
                                <TextBlock x:Name="RegistryCountText" Text="۰" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- دکمه به‌روزرسانی لیست -->
                        <Button Grid.Column="1"
                                ToolTip="بارگذاری مجدد رجیستری"
                                Style="{StaticResource IconToolButtonStyle}"
                                Width="24" Height="24"
                                Click="ReloadRegistryButton_Click">
                            <TextBlock Text="🔄" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- لیست دوربین‌های رجیستری -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,8">
                        <ListBox x:Name="RegistryCamerasListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="RegistryCamerasListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Brand}" FontSize="9.5" Foreground="#64748B" />
                                                    <TextBlock Text=" - " FontSize="9" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding IpAddress}" FontSize="9.5" FontFamily="JetBrains Mono, Consolas" Foreground="#0284C7" FlowDirection="LeftToRight" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- دکمه تخصیص سریع به اسلات فعال -->
                                            <Button Grid.Column="1"
                                                    Content="تخصیص"
                                                    ToolTip="تخصیص این دوربین به اسلات جاری"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="9.5"
                                                    Padding="6,2"
                                                    Height="22"
                                                    VerticalAlignment="Center"
                                                    Click="AssignCurrentItemToActiveSlot_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- بازرس اسلات انتخابی و تنظیم دستی RTSP -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="اسلات انتخابی:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                    <TextBlock x:Name="ActiveSlotLabel" Text="کانال ۱" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="3" Padding="5,1">
                                    <TextBlock Text="DPAPI امن" FontSize="8.5" FontWeight="Bold" Foreground="#15803D" />
                                </Border>
                            </Grid>

                            <!-- آدرس دستی RTSP -->
                            <TextBlock Text="آدرس استریم RTSP اسلات جاری:" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox x:Name="ManualRtspInput"
                                     Height="28"
                                     FontSize="10"
                                     FontFamily="JetBrains Mono, Consolas"
                                     Padding="4,2"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,5" />

                            <!-- پریست‌های سریع تیاندی و اعمال -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="/1/1" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Height="22" FontSize="9" Margin="0,0,2,0" ToolTip="پریست استریم اصلی تیاندی" Click="Preset11_Click" />
                                    <Button Content="/1/2" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Height="22" FontSize="9" Margin="0,0,2,0" ToolTip="پریست استریم فرعی تیاندی" Click="Preset12_Click" />
                                    <Button Content="/1/3" Style="{StaticResource SecondaryButtonStyle}" Padding="5,2" Height="22" FontSize="9" ToolTip="پریست استریم سوم تیاندی" Click="Preset13_Click" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="اعمال آدرس"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="22"
                                        Padding="8,0"
                                        FontSize="9.5"
                                        Click="ApplyManualRtsp_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ۳. نوار وضعیت و پنل کشویی لاگ‌های بومی (Collapsible Diagnostics)  -->
        <!-- ================================================================= -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <StackPanel>
                <!-- ردیف فشرده وضعیت دائمی -->
                <Grid Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="وضعیت پایش:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0" />
                        <TextBlock x:Name="ActiveStreamsSummaryText" Text="در حال آماده‌سازی..." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,16,0" />

                        <TextBlock Text="پروتکل انتقال:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="RTSP over TCP (--rtsp-tcp)" FontSize="10" FontFamily="Consolas" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,16,0" />

                        <TextBlock Text="شتاب‌دهنده گرافیکی:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="Direct3D11 / DirectX (--avcodec-hw=any)" FontSize="10" FontFamily="Consolas" Foreground="#0284C7" FontWeight="Bold" />
                    </StackPanel>

                    <!-- دکمه تاگل نمایش لاگ‌های LibVLC -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleLogPanelButton"
                                Content="📋 وقایع حقیقی LibVLC ▲"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="22"
                                Padding="8,1"
                                FontSize="9.5"
                                Margin="0,0,6,0"
                                Click="ToggleLogPanelButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- پنل بازشونده لاگ‌ها (به صورت پیش‌فرض بسته است تا ۱۰۰٪ فضا به ویدیو تعلق گیرد) -->
                <Border x:Name="DiagnosticsDrawer"
                        Height="120"
                        Margin="0,4,0,0"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="گزارشات فنی موتور LibVLC (بدون شبیه‌سازی | پسوردها با ماسک •••••••• محافظت شده‌اند):" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Button Grid.Column="1" Content="پاک‌سازی" Style="{StaticResource SecondaryButtonStyle}" Height="18" Padding="6,0" FontSize="8.5" Click="ClearLogs_Click" />
                        </Grid>

                        <ListBox x:Name="EventLogListBox"
                                 Grid.Row="1"
                                 Background="#FFFFFF"
                                 BorderBrush="{StaticResource BorderLightBrush}"
                                 BorderThickness="1"
                                 FontFamily="JetBrains Mono, Consolas"
                                 FontSize="9.5"
                                 FlowDirection="LeftToRight" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
