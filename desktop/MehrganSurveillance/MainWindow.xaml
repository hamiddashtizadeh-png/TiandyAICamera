<Window x:Class="MehrganSurveillance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MehrganSurveillance.Controls"
        mc:Ignorable="d"
        Title="سامانه نظارت تصویری هوشمند مهرگان | Mehrgan VMS Enterprise"
        Height="920" Width="1440"
        MinWidth="1150" MinHeight="750"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ۱. نوار ابزار اصلی شل برنامه و تب‌های ناوبری (Clean White Top VMS Shell - 46px) -->
            <RowDefinition Height="46" />
            <!-- ۲. فضای کاری اصلی نظارت (سایدبار راست + وال ویدیویی تیره مرکزی) -->
            <RowDefinition Height="*" />
            <!-- ۳. نوار تایم‌لاین پخش و کنترل‌های فشرده (Bottom Playback Timeline & Controls) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ۱. نوار ابزار اصلی شل برنامه و تب‌های ناوبری (Enterprise VMS Top Shell) -->
        <!-- تم سفید/روشن تمیز با لهجه‌های بنفش و آبی اینترپرایز                     -->
        <!-- ================================================================= -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                Padding="14,0"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- برند مهرگان و تب‌های ناوبری فوقانی -->
                    <ColumnDefinition Width="Auto" />
                    <!-- چیدمان‌های ماتریسی ۱x۱, ۲x۲, ۳x۳ و عملیات گروهی استریم -->
                    <ColumnDefinition Width="*" />
                    <!-- ساعت زنده مانیتورینگ و وضعیت موتور TCP -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ستون راست: برندینگ سامانه و تب‌های فشرده VMS -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- لوگو و نماد سپر بنفش/آبی -->
                    <Border Width="28" Height="28"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="5"
                            Margin="0,0,8,0">
                        <TextBlock Text="🛡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="سامانه نظارت تصویری مهرگان"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Mehrgan VMS Enterprise | C# .NET 10"
                                   FontSize="8.5"
                                   FontFamily="JetBrains Mono, Consolas, Segoe UI"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <!-- تب‌های فشرده فوقانی (Compact Top Navigation Tabs) -->
                    <Border Background="#F1F5F9"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- تب ۱: پایش زنده (فعال) -->
                            <Border Background="#FFFFFF"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="3"
                                    Padding="10,4"
                                    Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊞" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="پایش زنده (Live View)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- تب ۲: کشف هوشمند تجهیزات -->
                            <Button Content="🔍 کشف هوشمند (ONVIF)"
                                    ToolTip="کشف دوربین‌های شبکه محلی و تست پخش"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    Height="24"
                                    Padding="10,2"
                                    FontSize="10.5"
                                    Margin="0,0,2,0"
                                    Click="OpenDiscoveryWindow_Click" />

                            <!-- تب ۳: آرشیو و رویدادهای چهره -->
                            <Button Content="🛡 آرشیو چهره"
                                    ToolTip="مشاهده، جستجو و مدیریت آرشیو محلی چهره‌ها"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    Height="24"
                                    Padding="10,2"
                                    FontSize="10.5"
                                    Margin="0,0,2,0"
                                    Click="OpenFaceArchiveWindow_Click" />

                            <!-- تب ۴: پلاک‌خوان هوشمند (ANPR) -->
                            <Button Content="🚗 پلاک‌خوان هوشمند (ANPR)"
                                    ToolTip="آرشیو پلاک‌خوانی، جستجوی پلاک‌های ملی ایران و وضعیت موتور AI"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    Height="24"
                                    Padding="10,2"
                                    FontSize="10.5"
                                    Margin="0,0,2,0"
                                    Click="OpenAnprWindow_Click" />

                            <!-- تب ۴: پنل زنده چهره‌های شناسایی‌شده -->
                            <Button x:Name="ToggleLiveFacePanelButton"
                                    Content="👤 پنل چهره‌های زنده"
                                    ToolTip="باز / بسته کردن پنل جانبی نمایش چهره‌های شناسایی‌شده لحظه‌ای"
                                    Style="{StaticResource NavTabButtonStyle}"
                                    Height="24"
                                    Padding="10,2"
                                    FontSize="10.5"
                                    Click="ToggleLiveFacePanelButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ستون وسط: سوئیچرهای ماتریسی ۱x۱، ۲x۲، ۳x۳ و عملیات گروهی -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- انتخابگر ماتریس چیدمان (Segmented Layout Controls) -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="2"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Layout1x1Button"
                                    Content="⊞ ۱×۱"
                                    ToolTip="چیدمان تک‌تصویر با رزولوشن کامل (/1/1)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    Padding="10,2"
                                    Height="24"
                                    FontSize="10.5"
                                    Margin="0,0,2,0"
                                    Click="Layout1x1Button_Click" />

                            <Button x:Name="Layout2x2Button"
                                    Content="⊞ ۲×۲"
                                    ToolTip="چیدمان ۴ تصویر با استریم فرعی بهینه (/1/2)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,2"
                                    Height="24"
                                    FontSize="10.5"
                                    Margin="0,0,2,0"
                                    Click="Layout2x2Button_Click" />

                            <Button x:Name="Layout3x3Button"
                                    Content="⊞ ۳×۳"
                                    ToolTip="چیدمان ۹ تصویر با استریم فرعی (/1/2)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    Padding="10,2"
                                    Height="24"
                                    FontSize="10.5"
                                    Click="Layout3x3Button_Click" />
                        </StackPanel>
                    </Border>

                    <!-- عملیات همگانی استریم‌ها -->
                    <Button x:Name="ConnectAllButton"
                            Content="▶ اتصال همه"
                            ToolTip="برقراری اتصال همزمان کلیه استریم‌های فعال در چیدمان جاری"
                            Style="{StaticResource SuccessButtonStyle}"
                            Height="26"
                            Padding="12,0"
                            FontSize="10.5"
                            Margin="0,0,6,0"
                            Click="ConnectAllButton_Click" />

                    <Button x:Name="DisconnectAllButton"
                            Content="⏹ قطع همه"
                            ToolTip="قطع فوری کلیه استریم‌ها جهت آزادسازی منابع شبکه و گرافیک"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="26"
                            Padding="10,0"
                            FontSize="10.5"
                            Margin="0,0,8,0"
                            Click="DisconnectAllButton_Click" />
                </StackPanel>

                <!-- ستون چپ: نشانگر موتور LibVLC TCP و ساعت دیجیتال -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- نشانگر وضعیت موتور و شتاب‌دهنده گرافیکی -->
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,3"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EngineStatusDot" Width="6.5" Height="6.5" Fill="#16A34A" Margin="0,0,5,0" />
                            <TextBlock x:Name="EngineStatusText"
                                       Text="موتور فعال (TCP)"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- ساعت زنده مانیتورینگ -->
                    <Border Background="#0F172A"
                            CornerRadius="4"
                            Padding="8,2">
                        <TextBlock x:Name="LiveClockText"
                                   Text="--:--:--"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   FontFamily="JetBrains Mono, Consolas"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ۲. فضای کاری اصلی نظارت (Main VMS Workspace)                      -->
        <!-- سمت راست: سایدبار دوربین‌ها با جستجو، وضعیت، نام و انتخاب         -->
        <!-- سمت چپ و مرکز: وال ویدیویی تیره و بسیار بزرگ (Large Dark Video Wall) -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <!-- ستون ۰ در RTL = سمت راست پنجره (Right-side Camera Sidebar) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="200" MaxWidth="360" />
                <!-- ستون ۱ در RTL = مرکز (Large Dark Multi-Camera Video Wall) -->
                <ColumnDefinition Width="*" />
                <!-- ستون ۲ در RTL = سمت چپ پنجره (Left-side Live Face Events & Capture Panel) -->
                <ColumnDefinition x:Name="LiveFacePanelColumn" Width="280" MinWidth="220" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- پنل سایدبار سمت راست: جستجوی زنده، لیست دوربین‌ها و بازرس اسلات -->
            <!-- ============================================================= -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- سربرگ سایدبار و دکمه‌های ابزار -->
                        <RowDefinition Height="Auto" />
                        <!-- کادر جستجوی سریع دوربین‌ها -->
                        <RowDefinition Height="Auto" />
                        <!-- لیست دوربین‌های رجیستری -->
                        <RowDefinition Height="*" />
                        <!-- بازرس اسلات انتخابی و تنظیم آدرس RTSP -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- سربرگ سایدبار -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📹 دوربین‌های رجیستری"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="RegistryCountBadge"
                                    Background="#EEF2FF"
                                    CornerRadius="8"
                                    Padding="5,1"
                                    Margin="5,0,0,0">
                                <TextBlock x:Name="RegistryCountText" Text="۰" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- کلیدهای بارگذاری مجدد و کشف سریع -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button ToolTip="بارگذاری مجدد لیست رجیستری"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    Width="22" Height="22"
                                    Margin="0,0,3,0"
                                    Click="ReloadRegistryButton_Click">
                                <TextBlock Text="🔄" FontSize="9.5" />
                            </Button>
                            <Button ToolTip="کشف هوشمند دوربین‌های جدید"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    Width="22" Height="22"
                                    Click="OpenDiscoveryWindow_Click">
                                <TextBlock Text="➕" FontSize="9.5" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- کادر جستجوی زنده دوربین‌ها (Search Filter) -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4,2"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="SearchCameraInput"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="10.5"
                                     Padding="0"
                                     Height="22"
                                     VerticalContentAlignment="Center"
                                     ToolTip="جستجو بر اساس نام، برند یا آدرس IP دوربین"
                                     TextChanged="SearchCameraInput_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- لیست دوربین‌های رجیستری با شاخص آنلاین/آفلاین -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,6">
                        <ListBox x:Name="RegistryCamerasListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="RegistryCamerasListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,4"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- نشانگر وضعیت آنلاین/رجیستر -->
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- چراغ سبز وضعیت دوربین -->
                                            <Ellipse Grid.Column="0"
                                                     Width="6" Height="6"
                                                     Fill="#16A34A"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Brand}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text=" · " FontSize="8" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding IpAddress}" FontSize="9" FontFamily="JetBrains Mono, Consolas" Foreground="{StaticResource PrimaryBrush}" FlowDirection="LeftToRight" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- دکمه تخصیص سریع به اسلات فعال -->
                                            <Button Grid.Column="2"
                                                    Content="تخصیص"
                                                    ToolTip="تخصیص این دوربین به اسلات جاری وال"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="9"
                                                    Padding="5,1"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Click="AssignCurrentItemToActiveSlot_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- بازرس اسلات انتخابی و تنظیم دستی آدرس استریم RTSP -->
                    <Border Grid.Row="3"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="اسلات انتخابی:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,3,0" />
                                    <TextBlock x:Name="ActiveSlotLabel" Text="کانال ۱" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="DPAPI امن" FontSize="8" FontWeight="Bold" Foreground="#15803D" />
                                </Border>
                            </Grid>

                            <!-- کادر ورود آدرس استریم RTSP -->
                            <TextBox x:Name="ManualRtspInput"
                                     Height="24"
                                     FontSize="9.5"
                                     FontFamily="JetBrains Mono, Consolas"
                                     Padding="4,1"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,4" />

                            <!-- پریست‌های سریع تیاندی (/1/1, /1/2, /1/3) و دکمه اعمال -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="/1/1" Style="{StaticResource SecondaryButtonStyle}" Padding="4,1" Height="20" FontSize="8.5" Margin="0,0,2,0" ToolTip="پریست استریم اصلی تیاندی" Click="Preset11_Click" />
                                    <Button Content="/1/2" Style="{StaticResource SecondaryButtonStyle}" Padding="4,1" Height="20" FontSize="8.5" Margin="0,0,2,0" ToolTip="پریست استریم فرعی تیاندی" Click="Preset12_Click" />
                                    <Button Content="/1/3" Style="{StaticResource SecondaryButtonStyle}" Padding="4,1" Height="20" FontSize="8.5" ToolTip="پریست استریم سوم تیاندی" Click="Preset13_Click" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="اعمال آدرس"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="20"
                                        Padding="6,0"
                                        FontSize="9"
                                        Click="ApplyManualRtsp_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- بخش وال ویدیویی تیره بزرگ (Large Dark Multi-Camera Video Wall) -->
            <!-- اشغال‌کننده اکثریت فضای پنجره با حاشیه‌های بسیار ظریف و فشرده     -->
            <!-- ============================================================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- بنر اطلاع‌رسانی حالت تمام‌صفحه (در زمان ماکسیمایز) -->
                    <RowDefinition Height="Auto" />
                    <!-- شبکه ماتریسی بزرگ وال دوربین‌ها -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- بنر شناور بازگشت از تمام‌صفحه (Maximized State Floating Banner) -->
                <Border x:Name="MaximizedBanner"
                        Grid.Row="0"
                        Background="#0F172A"
                        BorderBrush="{StaticResource AccentPurpleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,5"
                        Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaximizedBannerText"
                                       Text="حالت تمام‌صفحه با استریم باکیفیت اصلی (Main-Stream /1/1) فعال است."
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="— جهت بازگشت به چیدمان قبلی کلید Esc یا دابل‌کلیک کنید."
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="بازگشت به چیدمان قبلی ❐"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="24"
                                Padding="10,0"
                                FontSize="10"
                                Click="RestoreMaximized_Click" />
                    </Grid>
                </Border>

                <!-- کادر وال ویدیویی سینمایی تیره با فاصله فشرده سلول‌ها -->
                <Border Grid.Row="1"
                        Background="{StaticResource DarkVideoWallBrush}"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <UniformGrid x:Name="CameraGrid"
                                 Rows="2"
                                 Columns="2"
                                 Margin="1">
                        <controls:CameraCell x:Name="CameraCell0" />
                        <controls:CameraCell x:Name="CameraCell1" />
                        <controls:CameraCell x:Name="CameraCell2" />
                        <controls:CameraCell x:Name="CameraCell3" />
                        <controls:CameraCell x:Name="CameraCell4" />
                        <controls:CameraCell x:Name="CameraCell5" />
                        <controls:CameraCell x:Name="CameraCell6" />
                        <controls:CameraCell x:Name="CameraCell7" />
                        <controls:CameraCell x:Name="CameraCell8" />
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- ستون ۲ در RTL: پنل زنده چهره‌های شناسایی‌شده (Live Face Capture) -->
            <!-- ============================================================= -->
            <Border Grid.Column="2"
                    x:Name="LiveFacePanelBorder"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- سربرگ پنل چهره‌های زنده با بج شمارنده -->
                        <RowDefinition Height="Auto" />
                        <!-- دکمه‌های سریع جستجو و باز کردن آرشیو تاریخی -->
                        <RowDefinition Height="Auto" />
                        <!-- لیست وقایع چهره‌های شناسایی‌شده لحظه‌ای -->
                        <RowDefinition Height="*" />
                        <!-- پاورقی تنظیمات سریع چهره -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- سربرگ پنل -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 چهره‌های شناسایی‌شده زنده"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="#DCFCE7"
                                    CornerRadius="8"
                                    Padding="5,1"
                                    Margin="5,0,0,0">
                                <TextBlock x:Name="LiveFaceCountBadgeText" Text="۰" FontSize="9" FontWeight="Bold" Foreground="#15803D" />
                            </Border>
                        </StackPanel>

                        <!-- دکمه بستن سریع پنل -->
                        <Button Grid.Column="1"
                                Content="✕"
                                ToolTip="بستن این پنل جانبی"
                                Style="{StaticResource IconToolButtonStyle}"
                                Width="20" Height="20"
                                FontSize="9.5"
                                Click="CloseLiveFacePanel_Click" />
                    </Grid>

                    <!-- نوار دکمه‌های جستجوی تاریخی و ساعتی -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <Button Content="🔍 جستجوی تاریخی و ساعتی چهره‌ها..."
                                    ToolTip="باز کردن پنجره آرشیو برای جستجوی پیشرفته بر اساس تاریخ، ساعت و دوربین"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="24"
                                    FontSize="10"
                                    Margin="0,0,0,4"
                                    Click="OpenFaceArchiveWindow_Click" />

                            <CheckBox x:Name="MasterFaceDetectionToggle"
                                      Content="⚡ پردازش هوش مصنوعی چهره (فعال)"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      Foreground="#15803D"
                                      FontSize="10"
                                      Margin="0,0,0,4"
                                      Click="MasterFaceDetectionToggle_Click" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="FaceOverlayLiveToggle"
                                          Content="نمایش کادر سبز روی زنده"
                                          IsChecked="True"
                                          FontSize="9.5"
                                          VerticalAlignment="Center"
                                          Click="FaceOverlayLiveToggle_Click" />
                                <Button Grid.Column="1"
                                        Content="پاک‌سازی لیست"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="18"
                                        FontSize="8.5"
                                        Padding="4,0"
                                        Click="ClearLiveFacesList_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- لیست فید چهره‌های شناسایی‌شده لحظه‌ای -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ListBox x:Name="LiveFaceCaptureListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,4"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- آیکون چهره با کادر سبز رنگ -->
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- تصویر پیش‌نمایش برش‌خورده چهره با کادر سبز درخشان مانیتورینگ -->
                                            <Border Grid.Column="0"
                                                    Width="38" Height="38"
                                                    Background="#0F172A"
                                                    BorderBrush="#22C55E"
                                                    BorderThickness="1.5"
                                                    CornerRadius="3"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CameraName}" FontWeight="SemiBold" FontSize="10" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="#DCFCE7" CornerRadius="2" Padding="3,0" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding ConfidenceText}" FontSize="8" FontWeight="Bold" Foreground="#15803D" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="زمان: " FontSize="8.5" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding TimestampString}" FontSize="8.5" FontFamily="JetBrains Mono, Consolas" Foreground="{StaticResource PrimaryBrush}" FlowDirection="LeftToRight" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- دکمه جزئیات یا مشاهده در آرشیو -->
                                            <Button Grid.Column="2"
                                                    Content="آرشیو"
                                                    ToolTip="مشاهده در آرشیو چهره"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="8.5"
                                                    Padding="4,1"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Click="ViewFaceInArchive_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- وضعیت فعال‌بودن هوش مصنوعی -->
                    <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="3" Padding="6,3" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="FaceAiStatusDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,5,0" />
                            <TextBlock x:Name="FaceAiStatusText" Text="هوش مصنوعی چهره فعال است" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ۳. نوار تایم‌لاین پخش و کنترل‌های فشرده (Bottom Playback Timeline) -->
        <!-- شامل نوار زمان ۲۴ ساعته و کنترل‌های فشرده مورد پشتیبانی عملکرد سیستم -->
        <!-- ================================================================= -->
        <Border Grid.Row="2"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <StackPanel>
                <!-- ردیف اول: نوار بصری تایم‌لاین ۲۴ ساعته مانیتورینگ VMS -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,3"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- نشانگرهای ساعتی ۲۴ ساعته خط زمان -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="00:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="03:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="06:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="09:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="12:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="15:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="18:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="24:00" FontSize="8.5" FontFamily="JetBrains Mono" Foreground="#64748B" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- ترک بصری تایم‌لاین با محدوده فعال و نشانگر موقعیت زنده -->
                        <Grid Grid.Row="1" Height="8">
                            <!-- خط پایه خاکستری -->
                            <Rectangle Fill="#334155" Height="4" RadiusX="2" RadiusY="2" VerticalAlignment="Center" />
                            <!-- نوار استریم فعال مانیتورینگ با رنگ بنفش/آبی -->
                            <Rectangle Fill="{StaticResource PrimaryBrush}" Height="4" RadiusX="2" RadiusY="2" Width="280" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <!-- نشانگر قرمز/سبز نقطه زنده (LIVE Playhead) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-2,2,0">
                                <Ellipse Width="8" Height="8" Fill="#10B981" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ردیف دوم: کنترل‌های فشرده پخش و تله‌متری موتور -->
                <Grid Height="24">
                    <Grid.ColumnDefinitions>
                        <!-- عملیات پخش و پرش زنده -->
                        <ColumnDefinition Width="Auto" />
                        <!-- خلاصه وضعیت پایش و سخت‌افزار -->
                        <ColumnDefinition Width="*" />
                        <!-- کلید باز کردن وقایع لاگ LibVLC -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- کنترل‌های فشرده پخش -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- دکمه سوئیچ پخش/توقف تمام استریم‌ها -->
                        <Button Style="{StaticResource TimelineButtonStyle}"
                                ToolTip="اتصال تمام استریم‌های فعال"
                                Margin="0,0,4,0"
                                Click="ConnectAllButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶ پخش زنده" FontSize="9.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TimelineButtonStyle}"
                                ToolTip="قطع موقت پخش"
                                Margin="0,0,10,0"
                                Click="DisconnectAllButton_Click">
                            <TextBlock Text="⏸ توقف" FontSize="9.5" />
                        </Button>

                        <!-- بج نشانگر زنده -->
                        <Border Background="#064E3B" CornerRadius="3" Padding="5,1" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#34D399" Margin="0,0,4,0" />
                                <TextBlock Text="پخش همزمان (SYNC LIVE)" FontSize="8.5" FontWeight="Bold" Foreground="#A7F3D0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- خلاصه تله‌متری پایش و مشخصات پروتکل -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="وضعیت پایش:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,4,0" />
                        <TextBlock x:Name="ActiveStreamsSummaryText" Text="در حال آماده‌سازی..." FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,14,0" />

                        <TextBlock Text="پروتکل انتقال:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,4,0" />
                        <TextBlock Text="RTSP over TCP" FontSize="9.5" FontFamily="JetBrains Mono" Foreground="#34D399" FontWeight="Bold" Margin="0,0,14,0" />

                        <TextBlock Text="شتاب‌دهنده گرافیکی:" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,4,0" />
                        <TextBlock Text="Direct3D11 / DirectX" FontSize="9.5" FontFamily="JetBrains Mono" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" />
                    </StackPanel>

                    <!-- دکمه پنل کشویی لاگ‌های بومی -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ToggleLogPanelButton"
                                Content="📋 وقایع LibVLC ▲"
                                Style="{StaticResource TimelineButtonStyle}"
                                Height="22"
                                Padding="8,1"
                                FontSize="9.5"
                                Click="ToggleLogPanelButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- پنل کشویی وقایع و لاگ‌های حقیقی LibVLC -->
                <Border x:Name="DiagnosticsDrawer"
                        Height="120"
                        Margin="0,4,0,0"
                        Background="#090E1A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="گزارشات فنی LibVLC (رویدادهای واقعی بدون شبیه‌سازی | اعتبارنامه‌ها با ماسک محافظت شده‌اند):" FontSize="9" Foreground="#94A3B8" />
                            <Button Grid.Column="1" Content="پاک‌سازی" Style="{StaticResource TimelineButtonStyle}" Height="18" Padding="6,0" FontSize="8.5" Click="ClearLogs_Click" />
                        </Grid>

                        <ListBox x:Name="EventLogListBox"
                                 Grid.Row="1"
                                 Background="#050811"
                                 BorderBrush="#1E293B"
                                 BorderThickness="1"
                                 FontFamily="JetBrains Mono, Consolas"
                                 FontSize="9"
                                 Foreground="#34D399"
                                 FlowDirection="LeftToRight" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
