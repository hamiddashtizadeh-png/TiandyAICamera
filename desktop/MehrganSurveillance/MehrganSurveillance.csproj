<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>سامانه نظارت تصویری مهرگان</ApplicationTitle>
    <RootNamespace>MehrganSurveillance</RootNamespace>
    <AssemblyName>MehrganSurveillance</AssemblyName>
    <!-- تضمین بیلد در حالت 64 بیتی هماهنگ با کتابخانه‌های محلی LibVLC -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- پکیج رسمی LibVLCSharp برای WPF -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.0" />
    <!-- کتابخانه‌های باینری نیتیو ویندوز LibVLC (شامل libvlc.dll و تمام پلاگین‌های دیکودر) -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <!-- کتابخانه رسمی ONNX Runtime با شتاب‌دهنده سخت‌افزاری DirectML و پشتیبانی از CPU EP -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <!-- کتابخانه استاندارد دات‌نت برای پایگاه داده محلی SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
  </ItemGroup>

  <PropertyGroup>
    <!-- مدیریت هشدارهای امنیتی بسته‌های ترانزیتی SQLite محلی -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

</Project>
