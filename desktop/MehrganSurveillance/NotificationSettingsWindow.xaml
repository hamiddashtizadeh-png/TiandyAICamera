<Window x:Class="MehrganSurveillance.NotificationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات اعلان هوشمند (WhatsApp / Telegram / SMS) | مهرگان"
        Height="780" Width="1060"
        MinWidth="880" MinHeight="640"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="#161B26"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ۱. سربرگ -->
        <Border Grid.Row="0" Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🔔 مدیریت هشدار و ارسال پیام (WhatsApp / پیام‌رسان / SMS)" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" />
                    <TextBlock Text="ارسال خودکار تصویر پلاک و چهره همراه با شماره دوربین، ساعت دقیق و تاریخ شمسی پس از تایید پلاک یا بهترین شات خروج فرد." FontSize="10.5" Foreground="#94A3B8" Margin="0,3,0,0" />
                </StackPanel>

                <CheckBox x:Name="MasterNotificationEnableCheck"
                          Grid.Column="1"
                          Content="فعال‌سازی سراسری ارسال اعلان"
                          FontSize="11.5"
                          FontWeight="Bold"
                          Foreground="#34D399"
                          VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ۲. بدنه اصلی: تنظیمات کانال‌ها (راست) و سابقه ارسال + قوانین (چپ) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- قوانین رویداد -->
                    <Border Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🎯 رویدادهای محرک ارسال پیام" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="NotifyAnprCheck" Content="🚗 تشخیص پلاک معتبر (ANPR)" Margin="0,0,16,6" FontSize="11" />
                                <CheckBox x:Name="NotifyFaceCheck" Content="👤 تشخیص انسان / بهترین شات چهره" Margin="0,0,16,6" FontSize="11" />
                                <CheckBox x:Name="AttachPhotoCheck" Content="🖼️ پیوست تصویر واقعی در واتس‌اپ و تلگرام" Margin="0,0,16,6" FontSize="11" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="فاصله ایمنی ضدتکرار برای هر دوربین (ثانیه):" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="CooldownSecondsBox" Width="70" Height="26" Text="8" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- تنظیمات واتس‌اپ -->
                    <Border Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <CheckBox x:Name="WhatsAppEnableCheck" Content="📱 ارسال از طریق واتس‌اپ (WhatsApp + تصویر)" FontSize="12" FontWeight="Bold" Foreground="#22C55E" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="سرویس‌دهنده API:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <ComboBox x:Name="WhatsAppProviderCombo" Grid.Column="1" Height="28" FontSize="10.5" SelectionChanged="WhatsAppProviderCombo_SelectionChanged">
                                    <ComboBoxItem Content="Ultramsg (ساده و سریع با ارسال تصویر)" Tag="Ultramsg" />
                                    <ComboBoxItem Content="Green-API (آپلود مستقیم فایل JPEG)" Tag="GreenApi" />
                                    <ComboBoxItem Content="Meta WhatsApp Cloud API (رسمی)" Tag="MetaCloudApi" />
                                    <ComboBoxItem Content="Webhook اختصاصی (JSON + Base64)" Tag="CustomWebhook" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="شماره گیرندگان:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="WhatsAppRecipientsBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" ToolTip="شماره‌ها را با کاما جدا کنید، مثال: 09123456789, 09351112233" />
                            </Grid>

                            <Grid x:Name="WhatsAppInstanceRow" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WhatsAppInstanceLabel" Text="Instance ID:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="WhatsAppInstanceBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid x:Name="WhatsAppWebhookRow" Margin="0,0,0,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="آدرس Webhook URL:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="WhatsAppWebhookUrlBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Token / API Key:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <PasswordBox x:Name="WhatsAppTokenBox" Grid.Column="1" Height="28" Background="#131722" Foreground="#F1F5F9" BorderBrush="#2C3548" Padding="6,4" FlowDirection="LeftToRight" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- تنظیمات پیام‌رسان تلگرام -->
                    <Border Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox x:Name="TelegramEnableCheck" Content="✈️ ارسال از طریق پیام‌رسان تلگرام (Telegram Bot + تصویر)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bot Token:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <PasswordBox x:Name="TelegramTokenBox" Grid.Column="1" Height="28" Background="#131722" Foreground="#F1F5F9" BorderBrush="#2C3548" Padding="6,4" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chat ID(s):" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="TelegramChatIdsBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" ToolTip="شناسه عددی کاربر، گروه یا کانال (با کاما جدا کنید)" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- تنظیمات پیامک (SMS) -->
                    <Border Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <CheckBox x:Name="SmsEnableCheck" Content="✉️ ارسال پیامک فوری (SMS)" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="پنل پیامکی:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <ComboBox x:Name="SmsProviderCombo" Grid.Column="1" Height="28" FontSize="10.5" SelectionChanged="SmsProviderCombo_SelectionChanged">
                                    <ComboBoxItem Content="کاوه‌نگار (Kavenegar API)" Tag="Kavenegar" />
                                    <ComboBoxItem Content="ایده پردازان (SMS.ir v1)" Tag="SmsIr" />
                                    <ComboBoxItem Content="ملی‌پیامک (Melipayamak)" Tag="Melipayamak" />
                                    <ComboBoxItem Content="آدرس HTTP/Webhook دلخواه" Tag="CustomWebhook" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="شماره موبایل گیرندگان:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="SmsRecipientsBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" ToolTip="مثال: 09123456789, 09351112233" />
                            </Grid>

                            <Grid x:Name="SmsSenderRow" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="شماره خط فرستنده:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="SmsSenderLineBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid x:Name="SmsApiKeyRow" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <PasswordBox x:Name="SmsApiKeyBox" Grid.Column="1" Height="28" Background="#131722" Foreground="#F1F5F9" BorderBrush="#2C3548" Padding="6,4" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid x:Name="SmsUserPassRow" Margin="0,0,0,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="نام کاربری / رمز عبور:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="SmsUsernameBox" Grid.Column="1" Height="28" Margin="0,0,6,0" FlowDirection="LeftToRight" />
                                <PasswordBox x:Name="SmsPasswordBox" Grid.Column="2" Height="28" Background="#131722" Foreground="#F1F5F9" BorderBrush="#2C3548" Padding="6,4" FlowDirection="LeftToRight" />
                            </Grid>

                            <Grid x:Name="SmsCustomUrlRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الگوی URL:" FontSize="10.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                <TextBox x:Name="SmsCustomUrlBox" Grid.Column="1" Height="28" FlowDirection="LeftToRight" ToolTip="متغیرهای مجاز: {to} {text} {plate} {camera} {channel} {date} {time}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- پیش‌نمایش پیام و سابقه ارسال زنده -->
            <Border Grid.Column="1" Background="#202634" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📄 پیش‌نمایش متن پیام خروجی و گزارش ارسال" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8" />

                    <Border Grid.Row="1" Background="#131722" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock x:Name="MessagePreviewText"
                                   FontSize="10.5"
                                   Foreground="#E2E8F0"
                                   TextWrapping="Wrap"
                                   LineHeight="19" />
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="سابقه ارسال‌های اخیر:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6" />
                        <DataGrid x:Name="HistoryGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  FontSize="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="زمان" Binding="{Binding JalaliTimestamp}" Width="115" />
                                <DataGridTextColumn Header="کانال" Binding="{Binding ChannelProvider}" Width="110" />
                                <DataGridTextColumn Header="رویداد" Binding="{Binding EventSummary}" Width="*" />
                                <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusMessage}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ۳. دکمه‌های پایین -->
        <Border Grid.Row="2" Background="#11151E" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusFeedbackText"
                           Grid.Column="0"
                           Text="اطلاعات توکن‌ها با Windows DPAPI به‌صورت رمزنگاری‌شده ذخیره می‌شوند."
                           FontSize="10.5"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SendTestButton"
                            Content="📤 ارسال پیام و تصویر آزمایشی"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32"
                            Margin="0,0,10,0"
                            Click="SendTestButton_Click" />
                    <Button x:Name="SaveButton"
                            Content="💾 ذخیره تنظیمات"
                            Style="{StaticResource SuccessButtonStyle}"
                            Height="32"
                            Padding="18,0"
                            Margin="0,0,8,0"
                            Click="SaveButton_Click" />
                    <Button Content="بستن"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
