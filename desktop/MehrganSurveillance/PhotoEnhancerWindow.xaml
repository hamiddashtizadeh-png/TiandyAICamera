<Window x:Class="MehrganSurveillance.PhotoEnhancerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🪄 شفاف‌سازی و رفع تاری عکس با هوش مصنوعی | AI Photo Restoration &amp; Super-Resolution"
        Height="860" Width="1380"
        MinWidth="1020" MinHeight="660"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="#161B26"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ۱. سربرگ و وضعیت موتور AI -->
            <RowDefinition Height="58" />
            <!-- ۲. فضای اصلی دوتایی -->
            <RowDefinition Height="*" />
            <!-- ۳. نوار وضعیت پایین -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ۱. هدر شل NetVideo -->
        <Border Grid.Row="0" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0" />
                                <GradientStop Color="#1A73E8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🪄" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="استودیو هوشمند شفاف‌سازی و رفع تاری عکس (AI Deblur &amp; Demoiré)"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#F1F5F9" />
                            <Border x:Name="EngineStatusBadge"
                                    Background="#0F293A"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EngineStatusBadgeText"
                                           Text="در حال بررسی موتور محلی..."
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#38BDF8" />
                            </Border>
                            <Border x:Name="MoireDetectedBadge"
                                    Visibility="Collapsed"
                                    Background="#451A03"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="MoireDetectedBadgeText"
                                           Text="🖥 الگوی شبکه مانیتور شناسایی شد"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#FBBF24" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="حذف خودکار شبکه پیکسلی مانیتور (Moiré)، رفع تاری YCbCr بدون تخریب رنگ و بزرگ‌نمایی فوق‌وضوح محلی"
                                   FontSize="9.5" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleSidePanelBtn"
                            Content="◀ مخفی کردن پنل"
                            ToolTip="مخفی یا نمایش پنل تنظیمات برای تمام‌صفحه شدن نمایشگر عکس"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="ToggleSidePanelBtn_Click" />
                    <Button x:Name="ImportOnnxButton"
                            Content="🧠 نصب مدل ONNX..."
                            ToolTip="افزودن فایل مدل شبکه عصبی (Real-ESRGAN / GFPGAN / CodeFormer .onnx) جهت پردازش گرافیکی DirectML"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="ImportOnnxButton_Click" />
                    <Button x:Name="CloseBtn"
                            Content="✕ بستن"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            Padding="14,0"
                            Click="CloseBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ۲. فضای کاری اصلی -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- پنل تنظیمات سمت راست (قابل مخفی شدن) -->
                <ColumnDefinition x:Name="SidePanelColumn" Width="335" />
                <!-- نمایشگر مقایسه قبل/بعد -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- پنل راست: ورود تصویر و پارامترهای AI -->
            <ScrollViewer x:Name="ConfigSidePanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- کارت ۱: انتخاب تصویر و برش کادر -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="۱. تصویر ورودی و انتخاب کادر پلاک / چهره" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />

                            <TextBlock x:Name="SourceInfoText"
                                       Text="هنوز تصویری بارگذاری نشده است (عکس را بکشید یا انتخاب کنید)"
                                       FontSize="9.5"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="BrowseImageButton"
                                        Content="📂 انتخاب عکس از سیستم"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="30"
                                        Margin="0,0,6,0"
                                        Click="BrowseImageButton_Click" />
                                <Button Grid.Column="1"
                                        x:Name="PasteClipboardButton"
                                        Content="📋 Paste"
                                        ToolTip="جای‌گذاری تصویر از کلیپ‌بورد ویندوز"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="30"
                                        Padding="10,0"
                                        Click="PasteClipboardButton_Click" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="CropSelectModeButton"
                                        Content="✂️ انتخاب کادر پلاک / چهره روی عکس"
                                        ToolTip="روی تصویر «قبل» با ماوس یک مستطیل دور پلاک یا چهره بکشید تا دقیقاً همان قسمت با وضوح بالا بازسازی شود"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28"
                                        FontSize="10"
                                        Margin="0,0,6,0"
                                        IsEnabled="False"
                                        Click="CropSelectModeButton_Click" />
                                <Button Grid.Column="1"
                                        x:Name="ResetCropButton"
                                        Content="↩️ کل عکس"
                                        ToolTip="بازگشت به تصویر کامل اولیه بدون برش"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28"
                                        FontSize="10"
                                        Padding="8,0"
                                        IsEnabled="False"
                                        Click="ResetCropButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- کارت ۲: سوژه و مقیاس بزرگ‌نمایی -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="۲. نوع سوژه و بزرگ‌نمایی فوق‌وضوح" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />

                            <StackPanel Margin="2,0,0,8">
                                <RadioButton x:Name="TargetPlateRadio"
                                             Content="🚗 پلاک خودرو (تقویت ارقام و رفع تاری حرکتی)"
                                             GroupName="EnhanceTarget"
                                             IsChecked="True"
                                             Foreground="#F1F5F9"
                                             FontSize="10.5"
                                             Margin="0,0,0,5"
                                             Checked="TargetRadio_Checked" />
                                <RadioButton x:Name="TargetFaceRadio"
                                             Content="👤 چهره انسان (رفع تاری نرم + حفظ پوست طبیعی)"
                                             GroupName="EnhanceTarget"
                                             Foreground="#F1F5F9"
                                             FontSize="10.5"
                                             Margin="0,0,0,5"
                                             Checked="TargetRadio_Checked" />
                                <RadioButton x:Name="TargetGeneralRadio"
                                             Content="🖼 صحنه عمومی یا کل خودرو (بهبود متعادل)"
                                             GroupName="EnhanceTarget"
                                             Foreground="#F1F5F9"
                                             FontSize="10.5"
                                             Checked="TargetRadio_Checked" />
                            </StackPanel>

                            <TextBlock Text="ضریب افزایش رزولوشن (Super-Resolution):" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,5" />
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="Scale1xRadio" Content="1x (اصلی)" GroupName="UpscaleFactor" Foreground="#E2E8F0" FontSize="10" />
                                <RadioButton x:Name="Scale2xRadio" Content="2x (پیشنهادی)" GroupName="UpscaleFactor" IsChecked="True" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" />
                                <RadioButton x:Name="Scale4xRadio" Content="4x (برش کوچک)" GroupName="UpscaleFactor" Foreground="#E2E8F0" FontSize="10" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- کارت ۳: تنظیمات دقیق موتور -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="۳. پارامترهای بازسازی و ضد-تاری (YCbCr)" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <!-- حذف شبکه مانیتور (Moiré) -->
                            <CheckBox x:Name="RemoveMoireCheckBox"
                                      Content="🖥 حذف شبکه پیکسلی مانیتور / موج (عکس از صفحه)"
                                      IsChecked="True"
                                      Foreground="#FBBF24"
                                      FontWeight="SemiBold"
                                      FontSize="10"
                                      Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="قدرت حذف شبکه مانیتور (Demoiré):" FontSize="10" Foreground="#CBD5E1" />
                                <TextBlock x:Name="MoireValueText" Grid.Column="1" Text="0.65" FontWeight="Bold" Foreground="#FBBF24" FontSize="10" />
                            </Grid>
                            <Slider x:Name="MoireSlider" Minimum="0" Maximum="1.0" Value="0.65" SmallChange="0.05" LargeChange="0.15" Margin="0,0,0,8" ValueChanged="ParamSlider_ValueChanged" />

                            <!-- اسلایدر تکرار دکانولوشن -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تکرار رفع تاری (TV-Richardson-Lucy):" FontSize="10" Foreground="#CBD5E1" />
                                <TextBlock x:Name="DeblurIterValueText" Grid.Column="1" Text="5" FontWeight="Bold" Foreground="#38BDF8" FontSize="10" />
                            </Grid>
                            <Slider x:Name="DeblurIterSlider" Minimum="0" Maximum="12" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8" ValueChanged="ParamSlider_ValueChanged" />

                            <!-- اسلایدر تیزسازی لبه -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="شدت شفاف‌سازی لبه‌ها (بدون هاله):" FontSize="10" Foreground="#CBD5E1" />
                                <TextBlock x:Name="SharpValueText" Grid.Column="1" Text="0.70" FontWeight="Bold" Foreground="#38BDF8" FontSize="10" />
                            </Grid>
                            <Slider x:Name="SharpSlider" Minimum="0" Maximum="1.6" Value="0.70" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,8" ValueChanged="ParamSlider_ValueChanged" />

                            <!-- اسلایدر حذف نویز -->
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="کاهش نویز سنسور و بلوک JPEG:" FontSize="10" Foreground="#CBD5E1" />
                                <TextBlock x:Name="DenoiseValueText" Grid.Column="1" Text="0.35" FontWeight="Bold" Foreground="#38BDF8" FontSize="10" />
                            </Grid>
                            <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="1.0" Value="0.35" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,8" ValueChanged="ParamSlider_ValueChanged" />

                            <CheckBox x:Name="LightingRecoveryCheckBox"
                                      Content="بازیابی نرم نور و کنتراست (Soft Y-CLAHE)"
                                      IsChecked="True"
                                      Foreground="#E2E8F0"
                                      FontSize="10"
                                      Margin="0,2,0,5" />

                            <CheckBox x:Name="PreferOnnxCheckBox"
                                      Content="استفاده از مدل شبکه عصبی ONNX (در صورت نصب)"
                                      IsChecked="True"
                                      Foreground="#34D399"
                                      FontSize="10" />
                        </StackPanel>
                    </Border>

                    <!-- کارت ۴: دکمه‌های اجرا و خروجی -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Button x:Name="EnhanceButton"
                                    Content="⚡ اجرای شفاف‌سازی و رفع تاری هوشمند"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36"
                                    FontSize="11.5"
                                    Margin="0,0,0,8"
                                    Click="EnhanceButton_Click" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="SaveEnhancedButton"
                                        Content="💾 ذخیره خروجی"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Height="30"
                                        Margin="0,0,4,0"
                                        IsEnabled="False"
                                        Click="SaveEnhancedButton_Click" />
                                <Button Grid.Column="1"
                                        x:Name="CopyEnhancedButton"
                                        Content="📋 کپی خروجی"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="30"
                                        Margin="4,0,0,0"
                                        IsEnabled="False"
                                        Click="CopyEnhancedButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- پنل چپ: نمایشگر کامل تصویر و مقایسه حرفه‌ای -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- نوار ابزار بالای نمایشگر (حالت نمایش + کنترل زوم دقیق) -->
                <Border Grid.Row="0" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="نمایش:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="SideBySideModeRadio" Content="دوتایی (قبل / بعد)" GroupName="ViewMode" IsChecked="True" Foreground="#F1F5F9" FontSize="10.5" Margin="0,0,10,0" VerticalAlignment="Center" Checked="ViewMode_Changed" />
                            <RadioButton x:Name="SplitSliderModeRadio" Content="اسلایدر روی هم (Wipe)" GroupName="ViewMode" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,10,0" VerticalAlignment="Center" Checked="ViewMode_Changed" />
                            <RadioButton x:Name="SingleLargeModeRadio" Content="تمام‌کادر خروجی" GroupName="ViewMode" Foreground="#F1F5F9" FontSize="10.5" VerticalAlignment="Center" Checked="ViewMode_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="بزرگ‌نمایی:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button x:Name="ZoomFitBtn" Content="⛶ تمام‌کادر (Fit)" Style="{StaticResource PrimaryButtonStyle}" Height="24" Padding="8,0" FontSize="9.5" Margin="0,0,4,0" Click="ZoomFitBtn_Click" />
                            <Button x:Name="Zoom100Btn" Content="100%" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,0" FontSize="9.5" Margin="0,0,4,0" Click="Zoom100Btn_Click" />
                            <Button x:Name="Zoom200Btn" Content="200%" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,0" FontSize="9.5" Margin="0,0,4,0" Click="Zoom200Btn_Click" />
                            <Button x:Name="Zoom400Btn" Content="400%" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="7,0" FontSize="9.5" Click="Zoom400Btn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- حالت ۱: نمایشگر دوتایی کنارهم (Side-by-Side) با Fit کامل بدون بریدگی -->
                <Grid x:Name="BeforeAfterSplitGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- کارت قبل (تصویر اصلی) -->
                    <Border Grid.Column="0" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#475569" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="قبل (تصویر اصلی)" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="BeforeResolutionText" Text="-- × --" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas" />
                                    <TextBlock x:Name="CropHintInlineText"
                                               Visibility="Collapsed"
                                               Text="  •  با ماوس دور پلاک یا چهره کادر بکشید"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#38BDF8"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#090D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="BeforePlaceholderText"
                                               Text="فایل عکس پلاک یا چهره را اینجا بکشید&#x0a;یا از دکمه «انتخاب عکس از سیستم» استفاده کنید"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <!-- در حالت Fit، ScrollBarVisibility=Disabled است تا عکس ۱۰۰٪ داخل کادر جا شود -->
                                    <ScrollViewer x:Name="BeforeScrollViewer"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  ScrollChanged="BeforeScrollViewer_ScrollChanged"
                                                  PreviewMouseWheel="Viewer_PreviewMouseWheel">
                                        <Grid x:Name="BeforeImageStage"
                                              FlowDirection="LeftToRight"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              MouseLeftButtonDown="BeforeImageStage_MouseLeftButtonDown"
                                              MouseMove="BeforeImageStage_MouseMove"
                                              MouseLeftButtonUp="BeforeImageStage_MouseLeftButtonUp">
                                            <Image x:Name="BeforeImage"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Canvas x:Name="CropOverlayCanvas"
                                                    IsHitTestVisible="False">
                                                <Rectangle x:Name="CropSelectionRect"
                                                           Visibility="Collapsed"
                                                           Stroke="#38BDF8"
                                                           StrokeThickness="2"
                                                           StrokeDashArray="4,2"
                                                           Fill="#3338BDF8" />
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock x:Name="BeforeSharpnessBadge" Text="وضوح: --" FontSize="9.5" Foreground="#CBD5E1" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock x:Name="BeforeBlurBadge" Text="تاری: --" FontSize="9.5" Foreground="#FBBF24" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="BeforeContrastBadge" Text="کنتراست: --" FontSize="9.5" Foreground="#CBD5E1" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- کارت بعد (تصویر شفاف‌شده) -->
                    <Border Grid.Column="1" Background="#202634" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#0284C7" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="بعد (واضح‌شده با AI)" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="AfterResolutionText" Text="-- × --" FontSize="10" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="7,2">
                                    <TextBlock x:Name="SharpnessGainBadge" Text="وضعیت: آماده" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="AfterPlaceholderText"
                                               Text="پس از انتخاب تصویر، نتیجه شفاف‌شده به صورت تمام‌کادر اینجا نمایش داده می‌شود"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <ScrollViewer x:Name="AfterScrollViewer"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  ScrollChanged="AfterScrollViewer_ScrollChanged"
                                                  PreviewMouseWheel="Viewer_PreviewMouseWheel">
                                        <Image x:Name="AfterImage"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Border Background="#161B26" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock x:Name="AfterSharpnessBadge" Text="وضوح: --" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock x:Name="AfterBlurBadge" Text="تاری: --" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="AfterDurationBadge" Text="زمان پردازش: --" FontSize="9.5" Foreground="#CBD5E1" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- حالت ۲: مقایسه اسلایدری روی هم (Before/After Interactive Wipe) -->
                <Border x:Name="SplitWipeContainer"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#202634"
                        BorderBrush="#0284C7"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#090D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid x:Name="SplitCompareStage" FlowDirection="LeftToRight" SizeChanged="SplitCompareStage_SizeChanged">
                                <!-- لایه زیرین: تصویر اصلی (قبل) -->
                                <Image x:Name="SplitBeforeImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- لایه رویی: تصویر واضح‌شده (بعد) با Clip پویا -->
                                <Image x:Name="SplitAfterImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" SizeChanged="SplitCompareStage_SizeChanged">
                                    <Image.Clip>
                                        <RectangleGeometry x:Name="SplitAfterClipRect" Rect="0,0,500,500" />
                                    </Image.Clip>
                                </Image>
                                <!-- خط جداکننده عمودی -->
                                <Canvas x:Name="SplitDividerCanvas" IsHitTestVisible="False">
                                    <Rectangle x:Name="SplitDividerLine" Width="2.5" Height="500" Fill="#38BDF8" Canvas.Left="250" Canvas.Top="0" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سمت چپ: بعد (واضح‌شده)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Slider x:Name="SplitPositionSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" FlowDirection="LeftToRight" ValueChanged="SplitPositionSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" Text="سمت راست: قبل (اصلی)" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- حالت ۳: نمایشگر تمام‌کادر خروجی (After Full Frame) -->
                <Border x:Name="SingleLargeAfterGrid"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#202634"
                        BorderBrush="#0284C7"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="10">
                    <Border Background="#090D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <ScrollViewer x:Name="SingleLargeScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="Viewer_PreviewMouseWheel">
                            <Image x:Name="SingleLargeAfterImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </ScrollViewer>
                    </Border>
                </Border>

                <!-- نوار گزارش الگوریتم و نتیجه OCR -->
                <Border Grid.Row="2" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="MethodSummaryText"
                                       Text="الگوریتم فعال: حذف خودکار شبکه مانیتور (YCbCr Demoiré) + TV-Richardson-Lucy + بزرگ‌نمایی Catmull-Rom + Soft Y-CLAHE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OnnxHintText"
                                       Text="نکته کاربردی: اگر عکس شما شامل کل خیابان یا مانیتور است، دکمه «✂️ انتخاب کادر پلاک / چهره» را بزنید و دقیقاً دور پلاک یا صورت کادر بکشید تا با بزرگ‌نمایی 2x/4x بیشترین وضوح را بگیرید."
                                       FontSize="9.2"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Border x:Name="OcrComparisonBox"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="#0F172A"
                                BorderBrush="#059669"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="خوانش OCR پلاک قبل و بعد:" FontSize="9" Foreground="#94A3B8" />
                                <TextBlock x:Name="OcrComparisonValueText" Text="--" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ۳. نوار وضعیت پایین -->
        <Border Grid.Row="2" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           Text="آماده دریافت تصویر پلاک یا چهره — نمایش پیش‌فرض روی «تمام‌کادر (Fit)» تنظیم شده است."
                           FontSize="9.5"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PrivacyBadgeText"
                           Grid.Column="1"
                           Text="🔒 پردازش ۱۰۰٪ آفلاین (بدون ارسال عکس به اینترنت)"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Foreground="#34D399"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
