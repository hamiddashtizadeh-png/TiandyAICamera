<Window x:Class="MehrganSurveillance.PhotoEnhancerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🪄 شفاف‌سازی و رفع تاری عکس با هوش مصنوعی | AI Photo Restoration &amp; Super-Resolution"
        Height="860" Width="1360"
        MinWidth="1050" MinHeight="680"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn, Tahoma, Segoe UI, sans-serif"
        Background="#161B26"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ۱. سربرگ و وضعیت موتور AI -->
            <RowDefinition Height="62" />
            <!-- ۲. فضای اصلی دوتایی -->
            <RowDefinition Height="*" />
            <!-- ۳. نوار وضعیت پایین -->
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ۱. هدر شل NetVideo -->
        <Border Grid.Row="0" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#38BDF8" Offset="0" />
                                <GradientStop Color="#1A73E8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🪄" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="استودیو هوشمند شفاف‌سازی و رفع تاری عکس (AI Deblur &amp; Super-Resolution)"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#F1F5F9" />
                            <Border x:Name="EngineStatusBadge"
                                    Background="#0F293A"
                                    BorderBrush="#0284C7"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="EngineStatusBadgeText"
                                           Text="در حال بررسی موتور محلی..."
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="بازسازی کاراکترهای پلاک‌های تار در حال حرکت و شفاف‌سازی پرتره چهره به‌صورت ۱۰۰٪ آفلاین روی سخت‌افزار محلی"
                                   FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CloseBtn"
                            Content="✕ بستن"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            Padding="14,0"
                            Click="CloseBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ۲. فضای کاری اصلی -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- پنل تنظیمات سمت راست -->
                <ColumnDefinition Width="365" />
                <!-- نمایشگر مقایسه قبل/بعد -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- پنل راست: ورود تصویر و پارامترهای AI -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- کارت ۱: انتخاب تصویر ورودی -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="۱. تصویر تار یا کم‌وضوح ورودی" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <TextBlock x:Name="SourceInfoText"
                                       Text="هنوز تصویری بارگذاری نشده است (فایل بکشید یا انتخاب کنید)"
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="BrowseImageButton"
                                        Content="📂 انتخاب عکس از سیستم (JPG/PNG)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="32"
                                        Margin="0,0,6,0"
                                        Click="BrowseImageButton_Click" />
                                <Button Grid.Column="1"
                                        x:Name="PasteClipboardButton"
                                        Content="📋 Paste"
                                        ToolTip="جای‌گذاری تصویر از کلیپ‌بورد ویندوز"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32"
                                        Padding="12,0"
                                        Click="PasteClipboardButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- کارت ۲: سوژه و مقیاس بزرگ‌نمایی -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="۲. نوع سوژه و بزرگ‌نمایی فوق‌وضوح" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                            <TextBlock Text="سوژه هدف برای انتخاب هسته دکانولوشن و مدل عصبی:" FontSize="10.5" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            <StackPanel Margin="4,0,0,10">
                                <RadioButton x:Name="TargetPlateRadio"
                                             Content="🚗 پلاک خودرو (رفع تاری حرکتی افقی + تقویت اعداد)"
                                             GroupName="EnhanceTarget"
                                             IsChecked="True"
                                             Foreground="#F1F5F9"
                                             FontSize="11"
                                             Margin="0,0,0,6"
                                             Checked="TargetRadio_Checked" />
                                <RadioButton x:Name="TargetFaceRadio"
                                             Content="👤 چهره انسان (رفع تاری متقارن + حفظ بافت طبیعی پوست)"
                                             GroupName="EnhanceTarget"
                                             Foreground="#F1F5F9"
                                             FontSize="11"
                                             Margin="0,0,0,6"
                                             Checked="TargetRadio_Checked" />
                                <RadioButton x:Name="TargetGeneralRadio"
                                             Content="🖼 صحنه عمومی یا کل خودرو (بهبود کلی وضوح و نور)"
                                             GroupName="EnhanceTarget"
                                             Foreground="#F1F5F9"
                                             FontSize="11"
                                             Checked="TargetRadio_Checked" />
                            </StackPanel>

                            <TextBlock Text="ضریب افزایش رزولوشن (Super-Resolution):" FontSize="10.5" Foreground="#CBD5E1" Margin="0,4,0,6" />
                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <RadioButton x:Name="Scale1xRadio" Content="1x (اصلی)" GroupName="UpscaleFactor" Foreground="#E2E8F0" FontSize="10.5" />
                                <RadioButton x:Name="Scale2xRadio" Content="2x (پیشنهادی)" GroupName="UpscaleFactor" IsChecked="True" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" />
                                <RadioButton x:Name="Scale4xRadio" Content="4x (فوق‌وضوح)" GroupName="UpscaleFactor" Foreground="#E2E8F0" FontSize="10.5" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- کارت ۳: تنظیمات دقیق موتور -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="۳. پارامترهای الگوریتم رفع تاری و بازسازی" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10" />

                            <!-- اسلایدر تکرار دکانولوشن -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تکرار رفع تاری (Richardson-Lucy):" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="DeblurIterValueText" Grid.Column="1" Text="8" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="DeblurIterSlider" Minimum="1" Maximum="14" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,10" ValueChanged="ParamSlider_ValueChanged" />

                            <!-- اسلایدر تیزسازی لبه -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="شدت بازسازی لبه‌ها و خطوط:" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="SharpValueText" Grid.Column="1" Text="0.95" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="SharpSlider" Minimum="0" Maximum="1.8" Value="0.95" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,10" ValueChanged="ParamSlider_ValueChanged" />

                            <!-- اسلایدر حذف نویز -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="کاهش نویز سنسور و برفک شب:" FontSize="10.5" Foreground="#CBD5E1" />
                                <TextBlock x:Name="DenoiseValueText" Grid.Column="1" Text="0.25" FontWeight="Bold" Foreground="#38BDF8" FontSize="10.5" />
                            </Grid>
                            <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="1.0" Value="0.25" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="ParamSlider_ValueChanged" />

                            <CheckBox x:Name="LightingRecoveryCheckBox"
                                      Content="بازیابی خودکار نور، سایه و کنتراست (CLAHE + Gamma)"
                                      IsChecked="True"
                                      Foreground="#E2E8F0"
                                      FontSize="10.5"
                                      Margin="0,2,0,6" />

                            <CheckBox x:Name="PreferOnnxCheckBox"
                                      Content="استفاده از مدل شبکه عصبی ONNX (در صورت وجود وزن)"
                                      IsChecked="True"
                                      Foreground="#34D399"
                                      FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <!-- کارت ۴: دکمه‌های اجرا و خروجی -->
                    <Border Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Button x:Name="EnhanceButton"
                                    Content="⚡ اجرای شفاف‌سازی و رفع تاری هوشمند"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36"
                                    FontSize="12"
                                    Margin="0,0,0,8"
                                    Click="EnhanceButton_Click" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="SaveEnhancedButton"
                                        Content="💾 ذخیره خروجی"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        IsEnabled="False"
                                        Click="SaveEnhancedButton_Click" />
                                <Button Grid.Column="1"
                                        x:Name="CopyEnhancedButton"
                                        Content="📋 کپی خروجی"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32"
                                        Margin="4,0,0,0"
                                        IsEnabled="False"
                                        Click="CopyEnhancedButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- پنل چپ: مقایسه بصری و گزارش دقیق کیفیت -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- نوار ابزار بالای نمایشگر -->
                <Border Grid.Row="0" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="حالت نمایش:" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="SideBySideModeRadio" Content="مقایسه دوتایی (قبل / بعد)" GroupName="ViewMode" IsChecked="True" Foreground="#F1F5F9" FontSize="10.5" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ViewMode_Changed" />
                            <RadioButton x:Name="SingleLargeModeRadio" Content="نمایش بزرگ تصویر واضح‌شده" GroupName="ViewMode" Foreground="#F1F5F9" FontSize="10.5" VerticalAlignment="Center" Checked="ViewMode_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ActualPixelsZoomCheckBox"
                                      Content="🔍 بزرگ‌نمایی پیکسل واقعی (۱۰۰٪)"
                                      Foreground="#38BDF8"
                                      FontSize="10.5"
                                      VerticalAlignment="Center"
                                      Checked="ZoomMode_Changed"
                                      Unchecked="ZoomMode_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- نمایشگر دوتایی کنارهم (Side-by-Side) -->
                <Grid x:Name="BeforeAfterSplitGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- کارت قبل (تصویر تار اصلی) -->
                    <Border Grid.Column="0" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#475569" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="قبل (تصویر اصلی)" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="BeforeResolutionText" Text="-- × --" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#090D16" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="BeforePlaceholderText"
                                               Text="فایل عکس پلاک یا چهره را اینجا بکشید&#x0a;یا از دکمه «انتخاب عکس از سیستم» استفاده کنید"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image x:Name="BeforeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="BeforeSharpnessBadge" Text="وضوح لبه: --" FontSize="10" Foreground="#CBD5E1" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="BeforeBlurBadge" Text="شاخص تاری: --" FontSize="10" Foreground="#FBBF24" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="7,3">
                                    <TextBlock x:Name="BeforeContrastBadge" Text="کنتراست: --" FontSize="10" Foreground="#CBD5E1" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- کارت بعد (تصویر شفاف‌شده) -->
                    <Border Grid.Column="1" Background="#202634" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#0284C7" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="بعد (واضح‌شده با AI)" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="AfterResolutionText" Text="-- × --" FontSize="10.5" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" FontFamily="JetBrains Mono, Consolas" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="4" Padding="7,2">
                                    <TextBlock x:Name="SharpnessGainBadge" Text="بهبود وضوح: --" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="AfterPlaceholderText"
                                               Text="پس از انتخاب تصویر، دکمه «اجرای شفاف‌سازی» را بزنید"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image x:Name="AfterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                <Border Background="#161B26" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="AfterSharpnessBadge" Text="وضوح لبه: --" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="AfterBlurBadge" Text="کاهش تاری: --" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#161B26" BorderBrush="#2C3548" BorderThickness="1" CornerRadius="4" Padding="7,3">
                                    <TextBlock x:Name="AfterDurationBadge" Text="زمان پردازش: --" FontSize="10" Foreground="#CBD5E1" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- نمایشگر بزرگ تک‌تصویر واضح‌شده (حالت جایگزین) -->
                <Border x:Name="SingleLargeAfterGrid"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#202634"
                        BorderBrush="#0284C7"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="SingleLargeAfterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ScrollViewer>
                </Border>

                <!-- کارت نتیجه OCR پلاک + راهنمای مدل‌های شبکه عصبی -->
                <Border Grid.Row="2" Background="#202634" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="MethodSummaryText"
                                       Text="الگوریتم فعال: ترکیب کاهش نویز دوطرفه + دکانولوشن تکراری ریچاردسون-لوسی + بزرگ‌نمایی Catmull-Rom + بازیابی نور CLAHE"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#E2E8F0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OnnxHintText"
                                       Text="نکته حرفه‌ای: در صورت قرار دادن فایل‌های وزن عصبی (مانند gfpgan-face.onnx یا realesrgan-x4.onnx / plate-sr-x2.onnx) در پوشه Models\Weights\، برنامه به‌صورت خودکار از شتاب‌دهنده گرافیکی DirectML استفاده خواهد کرد."
                                       FontSize="9.5"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Border x:Name="OcrComparisonBox"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="#0F172A"
                                BorderBrush="#059669"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="نتیجه OCR پلاک قبل و بعد از رفع تاری:" FontSize="9.5" Foreground="#94A3B8" />
                                <TextBlock x:Name="OcrComparisonValueText" Text="--" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ۳. نوار وضعیت پایین -->
        <Border Grid.Row="2" Background="#11151E" BorderBrush="#252D3D" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
